{
  "$id": "https://spec.aset.example/seed/0.1-rc11/schemas/payload-permit-use.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "candidate_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "permit_ref": {
      "maxLength": 300,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/@+\\-]*$",
      "type": "string"
    },
    "submission_id": {
      "maxLength": 300,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/@+\\-]*$",
      "type": "string"
    }
  },
  "required": [
    "permit_ref",
    "submission_id",
    "candidate_digest"
  ],
  "type": "object"
}
