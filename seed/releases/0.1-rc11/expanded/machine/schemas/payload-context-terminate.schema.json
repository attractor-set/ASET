{
  "$id": "https://spec.aset.example/seed/0.1-rc11/schemas/payload-context-terminate.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "child_context_id": {
      "maxLength": 300,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/@+\\-]*$",
      "type": "string"
    },
    "reason": {
      "enum": [
        "TRUST_LINEAGE_LOST"
      ]
    },
    "verification_ref": {
      "oneOf": [
        {
          "maxLength": 300,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/@+\\-]*$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "child_context_id",
    "reason",
    "verification_ref"
  ],
  "type": "object"
}
