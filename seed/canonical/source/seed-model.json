  "invariants": [
    {
      "id": "SEED-INV-001",
      "texts": {
        "en": "Every valid derived resolution is UNKNOWN, ALLOW or BLOCK.",
        "pt-BR": "Toda resolu\u00e7\u00e3o derivada v\u00e1lida \u00e9 UNKNOWN, ALLOW ou BLOCK.",
        "ru": "\u041a\u0430\u0436\u0434\u043e\u0435 \u0434\u043e\u043f\u0443\u0441\u0442\u0438\u043c\u043e\u0435 \u043f\u0440\u043e\u0438\u0437\u0432\u043e\u0434\u043d\u043e\u0435 \u0440\u0430\u0437\u0440\u0435\u0448\u0435\u043d\u0438\u0435 \u043f\u0440\u0438\u043d\u0430\u0434\u043b\u0435\u0436\u0438\u0442 UNKNOWN, ALLOW \u0438\u043b\u0438 BLOCK."
      },
      "verification": [
        "ASET-VERIFY-DECLARATIVE-STATE-VALIDATION",
        "ASET-VERIFY-PORTABLE-CASES",
        "ASET-VERIFY-BOUNDED-MODEL",
        "ASET-VERIFY-INVARIANT-COVERAGE",
        "ASET-VERIFY-SEMANTIC-MUTATIONS"
      ]
    },
    {
      "id": "SEED-INV-002",
      "texts": {
        "en": "Effect permission is true if and only if the unique valid terminal record is ALLOW.",
        "pt-BR": "A permiss\u00e3o do efeito \u00e9 verdadeira se, e somente se, o \u00fanico registro terminal v\u00e1lido for ALLOW.",
        "ru": "\u0420\u0430\u0437\u0440\u0435\u0448\u0435\u043d\u0438\u0435 \u044d\u0444\u0444\u0435\u043a\u0442\u0430 \u0438\u0441\u0442\u0438\u043d\u043d\u043e \u0442\u043e\u0433\u0434\u0430 \u0438 \u0442\u043e\u043b\u044c\u043a\u043e \u0442\u043e\u0433\u0434\u0430, \u043a\u043e\u0433\u0434\u0430 \u0435\u0434\u0438\u043d\u0441\u0442\u0432\u0435\u043d\u043d\u0430\u044f \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u0442\u0435\u043b\u044c\u043d\u0430\u044f \u0442\u0435\u0440\u043c\u0438\u043d\u0430\u043b\u044c\u043d\u0430\u044f \u0437\u0430\u043f\u0438\u0441\u044c \u0440\u0430\u0432\u043d\u0430 ALLOW."
      },
      "verification": [
        "ASET-VERIFY-DECLARATIVE-STATE-VALIDATION",
        "ASET-VERIFY-PORTABLE-CASES",
        "ASET-VERIFY-BOUNDED-MODEL",
        "ASET-VERIFY-INVARIANT-COVERAGE",
        "ASET-VERIFY-SEMANTIC-MUTATIONS"
      ]
    },
    {
      "id": "SEED-INV-003",
      "texts": {
        "en": "UNKNOWN and BLOCK never permit an effect.",
        "pt-BR": "UNKNOWN e BLOCK nunca permitem um efeito.",
        "ru": "UNKNOWN \u0438 BLOCK \u043d\u0438\u043a\u043e\u0433\u0434\u0430 \u043d\u0435 \u0440\u0430\u0437\u0440\u0435\u0448\u0430\u044e\u0442 \u044d\u0444\u0444\u0435\u043a\u0442."
