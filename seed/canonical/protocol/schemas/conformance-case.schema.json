{
  "$id": "https://spec.aset.example/seed/0.3/schemas/conformance-case.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "candidate": {
      "$ref": "operation.schema.json"
    },
    "case_id": {
      "$ref": "common.schema.json#/$defs/identifier"
    },
    "description": {
      "minLength": 1,
      "type": "string"
    },
    "expected": {
      "additionalProperties": false,
      "properties": {
        "accepted": {
          "type": "boolean"
        },
        "code": {
          "minLength": 1,
          "type": "string"
        },
        "effect_permitted": {
          "type": "boolean"
        },
        "reason": {
          "$ref": "common.schema.json#/$defs/reason"
        },
        "resolution": {
          "$ref": "common.schema.json#/$defs/resolution"
        },
        "state_changed": {
          "type": "boolean"
        }
      },
      "required": [
        "accepted",
        "code",
        "state_changed",
        "resolution",
        "effect_permitted",
        "reason"
      ],
      "type": "object"
    },
    "recognized_terminal_record_digests": {
      "description": "Externally validated terminal-record commitments available at the conformance verification boundary. This is recognition evidence, not retained canonical Seed state.",
      "items": {
        "$ref": "common.schema.json#/$defs/digest"
      },
      "type": "array",
      "uniqueItems": true
    },
    "initial_store": {
      "$ref": "resolution-store.schema.json"
    },
    "postconditions": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "equals": {},
          "path": {
            "pattern": "^/",
            "type": "string"
          }
        },
        "required": [
          "path",
          "equals"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "setup": {
      "items": {
        "$ref": "operation.schema.json"
      },
      "type": "array"
    }
  },
  "required": [
    "case_id",
    "description",
    "initial_store",
    "setup",
    "candidate",
    "expected",
    "postconditions"
  ],
  "type": "object"
}
