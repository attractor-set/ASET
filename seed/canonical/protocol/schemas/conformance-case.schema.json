{
  "$id": "https://spec.aset.example/seed/0.2/schemas/conformance-case.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "candidate": {
      "$ref": "transition.schema.json"
    },
    "case_id": {
      "$ref": "common.schema.json#/$defs/identifier"
    },
    "description": {
      "minLength": 1,
      "type": "string"
    },
    "expected": {
      "additionalProperties": false,
      "properties": {
        "accepted": {
          "type": "boolean"
        },
        "code": {
          "minLength": 1,
          "type": "string"
        },
        "enforcement": {
          "$ref": "common.schema.json#/$defs/enforcement"
        },
        "semantic_status": {
          "$ref": "common.schema.json#/$defs/status"
        },
        "state_changed": {
          "type": "boolean"
        }
      },
      "required": [
        "accepted",
        "code",
        "state_changed",
        "semantic_status",
        "enforcement"
      ],
      "type": "object"
    },
    "initial_state": {
      "anyOf": [
        {
          "$ref": "resolution-state.schema.json"
        },
        {
          "type": "null"
        }
      ]
    },
    "postconditions": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "equals": {},
          "path": {
            "pattern": "^/",
            "type": "string"
          }
        },
        "required": [
          "path",
          "equals"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "setup": {
      "items": {
        "$ref": "transition.schema.json"
      },
      "type": "array"
    }
  },
  "required": [
    "case_id",
    "description",
    "initial_state",
    "setup",
    "candidate",
    "expected",
    "postconditions"
  ],
  "type": "object"
}
