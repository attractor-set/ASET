{
  "$id": "https://spec.aset.example/seed/0.3/schemas/resolution-record.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "authority_evidence_digests": {
      "items": {
        "$ref": "common.schema.json#/$defs/digest"
      },
      "type": "array",
      "uniqueItems": true
    },
    "authority_id": {
      "$ref": "common.schema.json#/$defs/identifier"
    },
    "basis_digests": {
      "items": {
        "$ref": "common.schema.json#/$defs/digest"
      },
      "type": "array",
      "uniqueItems": true
    },
    "binding_digest": {
      "$ref": "common.schema.json#/$defs/digest"
    },
    "record_digest": {
      "$ref": "common.schema.json#/$defs/digest"
    },
    "request_digest": {
      "$ref": "common.schema.json#/$defs/digest"
    },
    "resolution": {
      "$ref": "common.schema.json#/$defs/terminal_resolution"
    },
    "resolution_id": {
      "$ref": "common.schema.json#/$defs/identifier"
    }
  },
  "required": [
    "record_digest",
    "request_digest",
    "resolution_id",
    "binding_digest",
    "resolution",
    "authority_id",
    "authority_evidence_digests",
    "basis_digests"
  ],
  "type": "object"
}
