{
  "$id": "https://spec.aset.example/seed/0.2/schemas/payload-open-resolution.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "authority": {
      "$ref": "resolution-authority.schema.json"
    },
    "context_id": {
      "$ref": "common.schema.json#/$defs/identifier"
    },
    "escalation_grants": {
      "items": {
        "$ref": "escalation-grant.schema.json"
      },
      "type": "array"
    },
    "policy_epoch": {
      "minimum": 0,
      "type": "integer"
    },
    "question_digest": {
      "$ref": "common.schema.json#/$defs/digest"
    },
    "resolution_id": {
      "$ref": "common.schema.json#/$defs/identifier"
    },
    "scope": {
      "$ref": "common.schema.json#/$defs/scope"
    },
    "state_root": {
      "$ref": "common.schema.json#/$defs/digest"
    }
  },
  "required": [
    "resolution_id",
    "context_id",
    "state_root",
    "question_digest",
    "policy_epoch",
    "scope",
    "authority"
  ],
  "type": "object"
}
