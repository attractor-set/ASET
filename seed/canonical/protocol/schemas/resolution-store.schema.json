{
  "$id": "https://spec.aset.example/seed/0.3/schemas/resolution-store.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "authority_bindings": {
      "items": {
        "$ref": "resolution-authority-binding.schema.json"
      },
      "type": "array"
    },
    "authority_grants": {
      "items": {
        "$ref": "authority-grant.schema.json"
      },
      "type": "array"
    },
    "records": {
      "items": {
        "$ref": "resolution-record.schema.json"
      },
      "type": "array"
    },
    "requests": {
      "items": {
        "$ref": "resolution-request.schema.json"
      },
      "type": "array"
    }
  },
  "required": [
    "requests",
    "records",
    "authority_bindings",
    "authority_grants"
  ],
  "type": "object"
}
