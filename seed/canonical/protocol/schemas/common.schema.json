{
  "$defs": {
    "digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "enforcement": {
      "enum": [
        "BLOCKED",
        "ALLOW"
      ]
    },
    "identifier": {
      "maxLength": 300,
      "minLength": 3,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/@+\\-]*$",
      "type": "string"
    },
    "scope": {
      "items": {
        "maxLength": 300,
        "minLength": 1,
        "type": "string"
      },
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    },
    "status": {
      "enum": [
        "UNKNOWN",
        "ACCEPT",
        "DENY"
      ]
    }
  },
  "$id": "https://spec.aset.example/seed/0.2/schemas/common.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
