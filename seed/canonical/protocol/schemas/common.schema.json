{
  "$defs": {
    "digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "identifier": {
      "maxLength": 300,
      "minLength": 3,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/@+\\-]*$",
      "type": "string"
    },
    "reason": {
      "maxLength": 100,
      "minLength": 1,
      "type": "string"
    },
    "resolution": {
      "enum": [
        "UNKNOWN",
        "ALLOW",
        "BLOCK"
      ]
    },
    "scope": {
      "items": {
        "maxLength": 300,
        "minLength": 1,
        "type": "string"
      },
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    },
    "terminal_resolution": {
      "enum": [
        "ALLOW",
        "BLOCK"
      ]
    }
  },
  "$id": "https://spec.aset.example/seed/0.3/schemas/common.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
