{
  "$id": "https://spec.aset.example/seed/0.1-rc11/schemas/payload-observation.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "claim_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "claim_subject_context_id": {
      "oneOf": [
        {
          "maxLength": 300,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/@+\\-]*$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "evidence_refs": {
      "items": {
        "maxLength": 300,
        "minLength": 1,
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/@+\\-]*$",
        "type": "string"
      },
      "type": "array",
      "uniqueItems": true
    },
    "permit_ref": {
      "maxLength": 300,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/@+\\-]*$",
      "type": "string"
    },
    "receipt_ref": {
      "maxLength": 300,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/@+\\-]*$",
      "type": "string"
    }
  },
  "required": [
    "permit_ref",
    "receipt_ref",
    "claim_digest",
    "evidence_refs",
    "claim_subject_context_id"
  ],
  "type": "object"
}
