{
  "$id": "https://spec.aset.example/seed/0.3/schemas/operation.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "kind": {
            "const": "REGISTER_REQUEST"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "payload-register-request.schema.json"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "SUBMIT_RESOLUTION"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "payload-submit-resolution.schema.json"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "EVALUATE_RESOLUTION"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "additionalProperties": false,
            "properties": {
              "resolution_id": {
                "$ref": "common.schema.json#/$defs/identifier"
              }
            },
            "required": [
              "resolution_id"
            ],
            "type": "object"
          }
        }
      }
    }
  ],
  "properties": {
    "kind": {
      "enum": [
        "REGISTER_REQUEST",
        "SUBMIT_RESOLUTION",
        "EVALUATE_RESOLUTION"
      ]
    },
    "payload": {
      "type": "object"
    }
  },
  "required": [
    "kind",
    "payload"
  ],
  "type": "object"
}
