@prefix aset: <https://aset.example/seed#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .

aset:ResolutionRecordShape a sh:NodeShape ;
    sh:targetClass aset:resolution_record ;
    sh:property [ sh:path aset:resolution ; sh:in ( "ALLOW" "BLOCK" ) ; sh:minCount 1 ; sh:maxCount 1 ] ;
    sh:property [ sh:path aset:resolutionId ; sh:minCount 1 ; sh:maxCount 1 ] ;
    sh:property [ sh:path aset:bindingDigest ; sh:minCount 1 ; sh:maxCount 1 ] ;
    sh:property [ sh:path aset:authorityId ; sh:minCount 1 ; sh:maxCount 1 ] ;
    sh:property [ sh:path aset:recordDigest ; sh:minCount 1 ; sh:maxCount 1 ] .
