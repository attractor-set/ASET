<?xml version="1.0" encoding="UTF-8"?>
<tbx xmlns="urn:iso:std:iso:30042:ed-2" type="TBX-Basic">
  <tbxHeader><fileDesc><titleStmt><title>ASET Seed 0.1-rc12 terminology</title></titleStmt></fileDesc></tbxHeader>
  <text><body style="dca">
    <conceptEntry id="seed.trust_space">
