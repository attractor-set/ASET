<?xml version="1.0" encoding="UTF-8"?>
<tbx xmlns="urn:iso:std:iso:30042:ed-2" type="TBX-Basic">
  <tbxHeader><fileDesc><titleStmt><title>ASET Seed 0.3 alpha 1 resolution terminology</title></titleStmt></fileDesc></tbxHeader>
  <text><body style="dca">
    <conceptEntry id="seed.resolution_binding">
      <langSec xml:lang="ru"><termSec><term>связка разрешения</term><termNote type="administrativeStatus">preferred</termNote></termSec></langSec>
      <langSec xml:lang="en"><termSec><term>resolution binding</term><termNote type="administrativeStatus">preferred</termNote></termSec></langSec>
      <langSec xml:lang="pt-BR"><termSec><term>vinculação de resolução</term><termNote type="administrativeStatus">preferred</termNote></termSec></langSec>
    </conceptEntry>
    <conceptEntry id="seed.resolution_request">
      <langSec xml:lang="ru"><termSec><term>запрос разрешения</term><termNote type="administrativeStatus">preferred</termNote></termSec></langSec>
      <langSec xml:lang="en"><termSec><term>resolution request</term><termNote type="administrativeStatus">preferred</termNote></termSec></langSec>
      <langSec xml:lang="pt-BR"><termSec><term>solicitação de resolução</term><termNote type="administrativeStatus">preferred</termNote></termSec></langSec>
    </conceptEntry>
    <conceptEntry id="seed.resolution_value">
      <langSec xml:lang="ru"><termSec><term>разрешение</term><termNote type="administrativeStatus">preferred</termNote></termSec></langSec>
      <langSec xml:lang="en"><termSec><term>resolution</term><termNote type="administrativeStatus">preferred</termNote></termSec></langSec>
      <langSec xml:lang="pt-BR"><termSec><term>resolução</term><termNote type="administrativeStatus">preferred</termNote></termSec></langSec>
    </conceptEntry>
    <conceptEntry id="seed.local_authority">
      <langSec xml:lang="ru"><termSec><term>локальная Authority</term><termNote type="administrativeStatus">preferred</termNote></termSec></langSec>
      <langSec xml:lang="en"><termSec><term>local Authority</term><termNote type="administrativeStatus">preferred</termNote></termSec></langSec>
      <langSec xml:lang="pt-BR"><termSec><term>Authority local</term><termNote type="administrativeStatus">preferred</termNote></termSec></langSec>
    </conceptEntry>
    <conceptEntry id="seed.authority_proof">
      <langSec xml:lang="ru"><termSec><term>доказательство Authority</term><termNote type="administrativeStatus">preferred</termNote></termSec></langSec>
      <langSec xml:lang="en"><termSec><term>Authority proof</term><termNote type="administrativeStatus">preferred</termNote></termSec></langSec>
      <langSec xml:lang="pt-BR"><termSec><term>prova de Authority</term><termNote type="administrativeStatus">preferred</termNote></termSec></langSec>
    </conceptEntry>
    <conceptEntry id="seed.evidence_reference">
      <langSec xml:lang="ru"><termSec><term>ссылка на основание</term><termNote type="administrativeStatus">preferred</termNote></termSec></langSec>
      <langSec xml:lang="en"><termSec><term>evidence reference</term><termNote type="administrativeStatus">preferred</termNote></termSec></langSec>
      <langSec xml:lang="pt-BR"><termSec><term>referência de evidência</term><termNote type="administrativeStatus">preferred</termNote></termSec></langSec>
    </conceptEntry>
    <conceptEntry id="seed.resolution_record">
      <langSec xml:lang="ru"><termSec><term>запись разрешения</term><termNote type="administrativeStatus">preferred</termNote></termSec></langSec>
      <langSec xml:lang="en"><termSec><term>resolution record</term><termNote type="administrativeStatus">preferred</termNote></termSec></langSec>
      <langSec xml:lang="pt-BR"><termSec><term>registro de resolução</term><termNote type="administrativeStatus">preferred</termNote></termSec></langSec>
    </conceptEntry>
    <conceptEntry id="seed.reconsideration_commitment">
      <langSec xml:lang="ru"><termSec><term>коммитмент пересмотра</term><termNote type="administrativeStatus">preferred</termNote></termSec></langSec>
      <langSec xml:lang="en"><termSec><term>reconsideration commitment</term><termNote type="administrativeStatus">preferred</termNote></termSec></langSec>
      <langSec xml:lang="pt-BR"><termSec><term>compromisso de reconsideração</term><termNote type="administrativeStatus">preferred</termNote></termSec></langSec>
    </conceptEntry>
  </body></text>
</tbx>
