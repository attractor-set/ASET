@prefix aset: <https://aset.example/seed#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

aset:SeedConceptScheme a skos:ConceptScheme ;
    skos:prefLabel "ASET Seed 0.2 alpha resolution concept scheme"@en .

aset:resolution_cycle a skos:Concept ;
    skos:inScheme aset:SeedConceptScheme ;
    skos:notation "seed.resolution_cycle" ;
    skos:prefLabel "цикл разрешения"@ru ;
    skos:prefLabel "resolution cycle"@en ;
    skos:prefLabel "ciclo de resolução"@pt-BR ;
    skos:definition "One immutably bound cycle for resolving an exact normative question."@en .

aset:context_binding a skos:Concept ;
    skos:inScheme aset:SeedConceptScheme ;
    skos:notation "seed.context_binding" ;
    skos:prefLabel "связка контекста"@ru ;
    skos:prefLabel "context binding"@en ;
    skos:prefLabel "vinculação de contexto"@pt-BR ;
    skos:definition "The exact context, state-root and policy-epoch binding within which a question is resolved."@en .

aset:resolution_question a skos:Concept ;
    skos:inScheme aset:SeedConceptScheme ;
    skos:notation "seed.resolution_question" ;
    skos:prefLabel "вопрос разрешения"@ru ;
    skos:prefLabel "resolution question"@en ;
    skos:prefLabel "questão de resolução"@pt-BR ;
    skos:definition "A canonically digested question and its bounded resolution scope."@en .

aset:resolution_status a skos:Concept ;
    skos:inScheme aset:SeedConceptScheme ;
    skos:notation "seed.resolution_status" ;
    skos:prefLabel "статус разрешения"@ru ;
    skos:prefLabel "resolution status"@en ;
    skos:prefLabel "estado de resolução"@pt-BR ;
    skos:definition "The normative status UNKNOWN, ACCEPT or DENY within one cycle."@en .

aset:enforcement_disposition a skos:Concept ;
    skos:inScheme aset:SeedConceptScheme ;
    skos:notation "seed.enforcement_disposition" ;
    skos:prefLabel "режим исполнения"@ru ;
    skos:prefLabel "enforcement disposition"@en ;
    skos:prefLabel "disposição de execução"@pt-BR ;
    skos:definition "The operational consequence of a decision: BLOCKED for UNKNOWN and DENY, ALLOW only for ACCEPT."@en .

aset:resolution_authority a skos:Concept ;
    skos:inScheme aset:SeedConceptScheme ;
    skos:notation "seed.resolution_authority" ;
    skos:prefLabel "власть разрешения"@ru ;
    skos:prefLabel "resolution authority"@en ;
    skos:prefLabel "autoridade de resolução"@pt-BR ;
    skos:definition "An explicitly empowered subject able to narrow UNKNOWN in an exact scope and epoch."@en .

aset:escalation_grant a skos:Concept ;
    skos:inScheme aset:SeedConceptScheme ;
    skos:notation "seed.escalation_grant" ;
    skos:prefLabel "разрешение эскалации"@ru ;
    skos:prefLabel "escalation grant"@en ;
    skos:prefLabel "autorização de escalonamento"@pt-BR ;
    skos:definition "An explicit authorization to pass an unresolved question to the next Resolution Authority without automatic authority inheritance."@en .

aset:evidence_reference a skos:Concept ;
    skos:inScheme aset:SeedConceptScheme ;
    skos:notation "seed.evidence_reference" ;
    skos:prefLabel "ссылка на доказательство"@ru ;
    skos:prefLabel "evidence reference"@en ;
    skos:prefLabel "referência de evidência"@pt-BR ;
    skos:definition "A content-addressed reference to material used when narrowing UNKNOWN."@en .

aset:resolution_record a skos:Concept ;
    skos:inScheme aset:SeedConceptScheme ;
    skos:notation "seed.resolution_record" ;
    skos:prefLabel "запись разрешения"@ru ;
    skos:prefLabel "resolution record"@en ;
    skos:prefLabel "registro de resolução"@pt-BR ;
    skos:definition "An immutable record of opening, escalation or terminal resolution and its provenance."@en .

aset:resolution_chain a skos:Concept ;
    skos:inScheme aset:SeedConceptScheme ;
    skos:notation "seed.resolution_chain" ;
    skos:prefLabel "цепочка разрешения"@ru ;
    skos:prefLabel "resolution chain"@en ;
    skos:prefLabel "cadeia de resolução"@pt-BR ;
    skos:definition "An acyclic sequence of explicitly authorized Resolution Authorities for one question."@en .
