@prefix aset: <https://aset.example/seed#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

aset:SeedOntology a owl:Ontology ;
    rdfs:label "ASET Seed bootstrap ontology"@en .

aset:context a owl:Class ;
    rdfs:label "контекст"@ru ;
    rdfs:label "context"@en ;
    rdfs:label "contexto"@pt-BR .

aset:authority a owl:Class ;
    rdfs:label "институциональное полномочие"@ru ;
    rdfs:label "institutional authority"@en ;
    rdfs:label "autoridade institucional"@pt-BR .

aset:decision a owl:Class ;
    rdfs:label "решение"@ru ;
    rdfs:label "decision"@en ;
    rdfs:label "decisão"@pt-BR .

aset:permit a owl:Class ;
    rdfs:label "разрешение"@ru ;
    rdfs:label "permit"@en ;
    rdfs:label "permissão"@pt-BR .

aset:execution_intent a owl:Class ;
    rdfs:label "намерение исполнения"@ru ;
    rdfs:label "execution intent"@en ;
    rdfs:label "intenção de execução"@pt-BR .

aset:observation a owl:Class ;
    rdfs:label "наблюдение"@ru ;
    rdfs:label "observation"@en ;
    rdfs:label "observação"@pt-BR .

aset:verification a owl:Class ;
    rdfs:label "проверка"@ru ;
    rdfs:label "verification"@en ;
    rdfs:label "verificação"@pt-BR .

aset:outcome a owl:Class ;
    rdfs:label "итоговое признание"@ru ;
    rdfs:label "outcome"@en ;
    rdfs:label "reconhecimento final"@pt-BR .
