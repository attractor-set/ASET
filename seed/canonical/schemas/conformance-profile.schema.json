{
  "$id": "https://github.com/attractor-set/ASET/raw/main/seed/canonical/schemas/conformance-profile.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "case_count": {
      "const": 24
    },
    "cases": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "case_id": {
            "type": "string"
          },
          "expected": {
            "type": "object"
          },
          "path": {
            "type": "string"
          },
          "polarity": {
            "enum": [
              "positive",
              "negative"
            ]
          },
          "sha256": {
            "pattern": "^sha256:[0-9a-f]{64}$",
            "type": "string"
          }
        },
        "required": [
          "case_id",
          "path",
          "polarity",
          "expected",
          "sha256"
        ],
        "type": "object"
      },
      "maxItems": 24,
      "minItems": 24,
      "type": "array"
    },
    "document_type": {
      "const": "aset-seed-resolution-conformance-profile"
    },
    "negative_count": {
      "const": 16
    },
    "positive_count": {
      "const": 8
    },
    "profile_id": {
      "const": "ASET-SEED-RESOLUTION-CONFORMANCE-CORPUS-V2"
    },
    "protocol": {
      "const": "ASET-SEED-RESOLUTION-CONFORMANCE-V2"
    },
    "schema_version": {
      "const": 2
    },
    "seed_version": {
      "const": "0.3.0-alpha.1"
    }
  },
  "required": [
    "document_type",
    "schema_version",
    "profile_id",
    "seed_version",
    "protocol",
    "case_count",
    "positive_count",
    "negative_count",
    "cases"
  ],
  "type": "object"
}
