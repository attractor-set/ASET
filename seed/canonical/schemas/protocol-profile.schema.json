  "additionalProperties": true,
  "properties": {
    "case_count": {
      "type": "integer"
    },
    "cases": {
      "type": "array"
    },
    "document_type": {
      "const": "aset-seed-protocol-profile"
    },
    "profile_id": {
      "type": "string"
    },
    "schema_count": {
      "type": "integer"
    },
    "schema_version": {
