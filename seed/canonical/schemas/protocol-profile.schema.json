{
  "$id": "https://github.com/attractor-set/ASET/raw/main/seed/canonical/schemas/protocol-profile.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "digest_profile_ref": {
      "const": "seed/canonical/protocol/digest-profile.json"
    },
    "document_type": {
      "const": "aset-seed-resolution-protocol-profile"
    },
    "implementation_precedence": {
      "const": "NONE"
    },
    "normative": {
      "const": true
    },
    "operation_kinds": {
      "const": [
        "REGISTER_REQUEST",
        "SUBMIT_RESOLUTION",
        "EVALUATE_RESOLUTION"
      ]
    },
    "profile_id": {
      "const": "ASET-SEED-RESOLUTION-WIRE-V2"
    },
    "resolution_values": {
      "const": [
        "UNKNOWN",
        "ALLOW",
        "BLOCK"
      ]
    },
    "schema_count": {
      "const": 12
    },
    "schema_version": {
      "const": 2
    },
    "schemas": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "path": {
            "type": "string"
          },
          "sha256": {
            "pattern": "^sha256:[0-9a-f]{64}$",
            "type": "string"
          }
        },
        "required": [
          "name",
          "path",
          "id",
          "sha256"
        ],
        "type": "object"
      },
      "maxItems": 12,
      "minItems": 12,
      "type": "array"
    },
    "seed_version": {
      "const": "0.3.0-alpha.1"
    },
    "stored_terminal_values": {
      "const": [
        "ALLOW",
        "BLOCK"
      ]
    }
  },
  "required": [
    "document_type",
    "schema_version",
    "profile_id",
    "seed_version",
    "normative",
    "implementation_precedence",
    "resolution_values",
    "stored_terminal_values",
    "operation_kinds",
    "schemas",
    "schema_count",
    "digest_profile_ref"
  ],
  "type": "object"
}
