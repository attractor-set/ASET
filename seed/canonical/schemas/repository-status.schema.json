{
  "$id": "https://github.com/attractor-set/ASET/raw/main/seed/canonical/schemas/repository-status.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "assurance_boundary": {
      "additionalProperties": {
        "type": "string"
      },
      "minProperties": 9,
      "type": "object"
    },
    "current_stable_seed_release": {
      "const": "0.1-rc11"
    },
    "current_stable_seed_status": {
      "const": "FROZEN_AUDITED_PASS_WITH_LIMITATIONS"
    },
    "document_type": {
      "const": "aset-repository-status"
    },
    "expanded_rc11": {
      "const": "BYTE_EXACT_MATERIALIZATION"
    },
    "external_third_party_audit": {
      "const": "PENDING"
    },
    "frozen_seed_bundle_sha256": {
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "frozen_seed_documentation_sha256": {
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "generated_languages": {
      "const": [
        "ru",
        "en",
        "pt-BR"
      ]
    },
    "machine_readable_canon": {
      "const": "NORMATIVE_CANON_COMPLETE"
    },
    "next_seed_status": {
      "const": "RC12_RELEASE_CANDIDATE_READY"
    },
    "next_seed_version": {
      "const": "0.1-rc12"
    },
    "reference_implementation": {
      "const": "PRODUCTION_READY_BOUNDED_PROFILE"
    },
    "repository": {
      "const": "ASET"
    },
    "repository_production_gate": {
      "const": "PASS_REQUIRED_ON_EVERY_MAIN_CHANGE"
    },
    "repository_production_readiness": {
      "const": "DOCUMENTATION_AND_BOUNDED_RUNTIME_PRODUCTION_READY"
    },
    "repository_role": {
      "const": "SPECIFICATION_AND_BOUNDED_REFERENCE_RUNTIME"
    },
    "repository_url": {
      "const": "https://github.com/attractor-set/ASET"
    },
    "runtime_profile_id": {
      "const": "ASET-SEED-RUNTIME-SQLITE-SINGLE-NODE-V1"
    },
    "schema_version": {
      "const": 3
    },
    "seed_runtime_production": {
      "const": "PRODUCTION_READY_SINGLE_NODE_SQLITE_PROFILE"
    },
    "wire_compatibility_profile": {
      "const": "ASET-SEED-WIRE-0.1-RC11-COMPAT"
    }
  },
  "required": [
    "document_type",
    "schema_version",
    "repository",
    "repository_url",
    "repository_role",
    "repository_production_readiness",
    "repository_production_gate",
    "current_stable_seed_release",
    "current_stable_seed_status",
    "next_seed_version",
    "next_seed_status",
    "machine_readable_canon",
    "reference_implementation",
    "seed_runtime_production",
    "runtime_profile_id",
    "wire_compatibility_profile",
    "external_third_party_audit",
    "expanded_rc11",
    "frozen_seed_bundle_sha256",
    "frozen_seed_documentation_sha256",
    "generated_languages",
    "assurance_boundary"
  ],
  "title": "ASET repository status",
  "type": "object"
}
