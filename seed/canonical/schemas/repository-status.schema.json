    "repository_role",
    "active_seed_version",
    "active_seed_status",
    "active_seed_model",
    "active_conformance_protocol",
    "predecessor_status",
    "predecessor_version",
    "implementation_precedence",
    "extension_separation",
    "external_third_party_audit",
    "architectural_role",
    "operational_nucleus",
