{
  "$id": "https://github.com/attractor-set/ASET/raw/main/seed/canonical/schemas/repository-status.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "active_conformance_protocol": {
      "const": "ASET-SEED-RESOLUTION-CONFORMANCE-V1"
    },
    "active_seed_model": {
      "const": "seed/canonical/source/seed-model.json"
    },
    "active_seed_status": {
      "const": "RESOLUTION_CORE_ALPHA"
    },
    "active_seed_version": {
      "const": "0.2.0-alpha.1"
    },
    "document_type": {
      "const": "aset-repository-status"
    },
    "extension_separation": {
      "const": "IN_PROGRESS"
    },
    "external_third_party_audit": {
      "const": "PENDING"
    },
    "implementation_precedence": {
      "const": "NONE"
    },
    "predecessor_status": {
      "const": "HISTORICAL_MIGRATION_SOURCE"
    },
    "predecessor_version": {
      "const": "0.1-rc12"
    },
    "repository_role": {
      "const": "OPEN_IMPLEMENTATION_NEUTRAL_SPECIFICATION"
    },
    "schema_version": {
      "const": 2
    }
  },
  "required": [
    "document_type",
    "schema_version",
    "repository_role",
    "active_seed_version",
    "active_seed_status",
    "active_seed_model",
    "active_conformance_protocol",
    "predecessor_status",
    "predecessor_version",
    "implementation_precedence",
    "extension_separation",
    "external_third_party_audit"
  ],
  "title": "ASET repository status",
  "type": "object"
}
