{
  "$defs": {
    "localized": {
      "additionalProperties": false,
      "properties": {
        "en": {
          "minLength": 1,
          "type": "string"
        },
        "pt-BR": {
          "minLength": 1,
          "type": "string"
        },
        "ru": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "ru",
        "en",
        "pt-BR"
      ],
      "type": "object"
    }
  },
  "$id": "https://github.com/attractor-set/ASET/raw/main/seed/canonical/schemas/seed-model.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "assurance": {
      "minProperties": 8,
      "type": "object"
    },
    "canonicality": {
      "minProperties": 8,
      "type": "object"
    },
    "concepts": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "definitions": {
            "$ref": "#/$defs/localized"
          },
          "id": {
            "pattern": "^seed\\.[a-z0-9_]+",
            "type": "string"
          },
          "labels": {
            "$ref": "#/$defs/localized"
          },
          "symbol": {
            "pattern": "^[A-Za-z][A-Za-z0-9]*$",
            "type": "string"
          }
        },
        "required": [
          "id",
          "symbol",
          "labels",
          "definitions"
        ],
        "type": "object"
      },
      "maxItems": 8,
      "minItems": 8,
      "type": "array"
    },
    "conformance_profile_ref": {
      "const": "seed/canonical/conformance/conformance-profile.json"
    },
    "implementation_boundary": {
      "additionalProperties": false,
      "properties": {
        "conformance_protocol_ref": {
          "const": "seed/canonical/conformance/implementation-conformance-protocol.json"
        },
        "implementation_precedence": {
          "const": "NONE"
        },
        "normative_status": {
          "const": "IMPLEMENTATION_NEUTRAL"
        },
        "profile_rule": {
          "minLength": 150,
          "type": "string"
        },
        "required_observables": {
          "items": {
            "type": "string"
          },
          "minItems": 7,
          "type": "array"
        },
        "unspecified_by_seed": {
          "items": {
            "type": "string"
          },
          "minItems": 12,
          "type": "array"
        }
      },
      "required": [
        "normative_status",
        "implementation_precedence",
        "conformance_protocol_ref",
        "required_observables",
        "unspecified_by_seed",
        "profile_rule"
      ],
      "type": "object"
    },
    "invariants": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "assurance_refs": {
            "items": {
              "pattern": "^ASET-PROOF-INV-[0-9]{3}$",
              "type": "string"
            },
            "minItems": 1,
            "type": "array",
            "uniqueItems": true
          },
          "id": {
            "pattern": "^SEED-INV-[0-9]{3}$",
            "type": "string"
          },
          "texts": {
            "$ref": "#/$defs/localized"
          },
          "verification": {
            "items": {
              "type": "string"
            },
            "minItems": 1,
            "type": "array"
          }
        },
        "required": [
          "id",
          "texts",
          "verification",
          "assurance_refs"
        ],
        "type": "object"
      },
      "maxItems": 12,
      "minItems": 12,
      "type": "array"
    },
    "languages": {
      "const": [
        "ru",
        "en",
        "pt-BR"
      ]
    },
    "model_id": {
      "const": "ASET-SEED-RESOLUTION-CANON-0.3-ALPHA1"
    },
    "predecessor": {
      "const": "ASET-SEED-RESOLUTION-CANON-0.2-ALPHA2"
    },
    "protocol_profile_ref": {
      "const": "seed/canonical/protocol/protocol-profile.json"
    },
    "publication": {
      "required": [
        "titles",
        "headings"
      ],
      "type": "object"
    },
    "requirements": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "area": {
            "minLength": 1,
            "type": "string"
          },
          "id": {
            "pattern": "^ASET-SEED-REQ-[0-9]{3}$",
            "type": "string"
          },
          "modality": {
            "enum": [
              "MUST",
              "MUST_NOT",
              "SHOULD",
              "MAY"
            ]
          },
          "predicate": {
            "pattern": "^[a-z][a-z0-9_]+",
            "type": "string"
          },
          "source": {
            "minLength": 1,
            "type": "string"
          },
          "subject": {
            "minLength": 1,
            "type": "string"
          },
          "texts": {
            "$ref": "#/$defs/localized"
          },
          "verification": {
            "items": {
              "type": "string"
            },
            "minItems": 1,
            "type": "array"
          }
        },
        "required": [
          "id",
          "area",
          "modality",
          "subject",
          "predicate",
          "texts",
          "verification",
          "source"
        ],
        "type": "object"
      },
      "maxItems": 12,
      "minItems": 12,
      "type": "array"
    },
    "resolution_algebra": {
      "additionalProperties": false,
      "properties": {
        "conflict_result": {
          "const": "UNKNOWN"
        },
        "derived": {
          "const": "UNKNOWN"
        },
        "effect_permitted_if": {
          "const": "ALLOW"
        },
        "fail_closed_values": {
          "const": [
            "UNKNOWN",
            "BLOCK"
          ]
        },
        "stored_terminal": {
          "const": [
            "ALLOW",
            "BLOCK"
          ]
        },
        "unknown_semantics": {
          "minLength": 30,
          "type": "string"
        },
        "values": {
          "const": [
            "UNKNOWN",
            "ALLOW",
            "BLOCK"
          ]
        }
      },
      "required": [
        "values",
        "derived",
        "stored_terminal",
        "effect_permitted_if",
        "fail_closed_values",
        "conflict_result",
        "unknown_semantics"
      ],
      "type": "object"
    },
    "schema_version": {
      "const": 4
    },
    "status": {
      "const": "MINIMAL_STRONG_CORE_ALPHA"
    },
    "transitions": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "authority_rule": {
            "minLength": 1,
            "type": "string"
          },
          "binding_rule": {
            "minLength": 1,
            "type": "string"
          },
          "created_artifacts": {
            "items": {
              "type": "string"
            },
            "minItems": 1,
            "type": "array"
          },
          "from_resolution": {
            "enum": [
              null,
              "UNKNOWN"
            ],
            "type": [
              "string",
              "null"
            ]
          },
          "id": {
            "pattern": "^SEED-TX-[0-9]{3}$",
            "type": "string"
          },
          "kind": {
            "enum": [
              "REGISTER_REQUEST",
              "SUBMIT_RESOLUTION",
              "EVALUATE_RESOLUTION"
            ]
          },
          "payload_schema": {
            "type": "string"
          },
          "terminal": {
            "type": "boolean"
          },
          "to_resolution": {
            "enum": [
              "UNKNOWN",
              "ALLOW_OR_BLOCK",
              "DERIVED"
            ]
          }
        },
        "required": [
          "id",
          "kind",
          "payload_schema",
          "from_resolution",
          "to_resolution",
          "authority_rule",
          "binding_rule",
          "created_artifacts",
          "terminal"
        ],
        "type": "object"
      },
      "maxItems": 3,
      "minItems": 3,
      "type": "array"
    },
    "version": {
      "const": "0.3.0-alpha.1"
    }
  },
  "required": [
    "schema_version",
    "model_id",
    "version",
    "status",
    "predecessor",
    "canonicality",
    "languages",
    "publication",
    "resolution_algebra",
    "concepts",
    "requirements",
    "invariants",
    "transitions",
    "protocol_profile_ref",
    "conformance_profile_ref",
    "assurance",
    "implementation_boundary"
  ],
  "title": "ASET Seed minimal resolution-recognition canonical model",
  "type": "object"
}
