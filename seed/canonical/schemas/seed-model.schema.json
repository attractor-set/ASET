{
  "$defs": {
    "localized": {
      "additionalProperties": false,
      "properties": {
        "en": {
          "minLength": 1,
          "type": "string"
        },
        "pt-BR": {
          "minLength": 1,
          "type": "string"
        },
        "ru": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "ru",
        "en",
        "pt-BR"
      ],
      "type": "object"
    }
  },
  "$id": "https://github.com/attractor-set/ASET/raw/main/seed/canonical/schemas/seed-model.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "assurance": {
      "minProperties": 7,
      "type": "object"
    },
    "canonicality": {
      "minProperties": 7,
      "type": "object"
    },
    "concepts": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "definitions": {
            "$ref": "#/$defs/localized"
          },
          "id": {
            "pattern": "^seed\\.[a-z0-9_]+",
            "type": "string"
          },
          "labels": {
            "$ref": "#/$defs/localized"
          },
          "symbol": {
            "pattern": "^[A-Za-z][A-Za-z0-9]*$",
            "type": "string"
          }
        },
        "required": [
          "id",
          "symbol",
          "labels",
          "definitions"
        ],
        "type": "object"
      },
      "minItems": 20,
      "type": "array"
    },
    "conformance_profile_ref": {
      "const": "seed/canonical/conformance/conformance-profile.json"
    },
    "implementation_boundary": {
      "additionalProperties": false,
      "properties": {
        "conformance_protocol_ref": {
          "const": "seed/canonical/conformance/implementation-conformance-protocol.json"
        },
        "implementation_precedence": {
          "const": "NONE"
        },
        "normative_status": {
          "const": "IMPLEMENTATION_NEUTRAL"
        },
        "profile_rule": {
          "minLength": 80,
          "type": "string"
        },
        "required_observables": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "minItems": 5,
          "type": "array"
        },
        "unspecified_by_seed": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "minItems": 7,
          "type": "array"
        }
      },
      "required": [
        "normative_status",
        "implementation_precedence",
        "conformance_protocol_ref",
        "required_observables",
        "unspecified_by_seed",
        "profile_rule"
      ],
      "type": "object"
    },
    "invariants": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "id": {
            "pattern": "^SEED-INV-[0-9]{3}$",
            "type": "string"
          },
          "texts": {
            "$ref": "#/$defs/localized"
          },
          "verification": {
            "items": {
              "type": "string"
            },
            "minItems": 1,
            "type": "array"
          }
        },
        "required": [
          "id",
          "texts",
          "verification"
        ],
        "type": "object"
      },
      "minItems": 29,
      "type": "array"
    },
    "languages": {
      "const": [
        "ru",
        "en",
        "pt-BR"
      ]
    },
    "model_id": {
      "const": "ASET-SEED-CANON-RC12"
    },
    "predecessor": {
      "const": "ASET Seed 0.1-rc11"
    },
    "protocol_profile_ref": {
      "const": "seed/canonical/protocol/protocol-profile.json"
    },
    "publication": {
      "required": [
        "titles",
        "headings"
      ],
      "type": "object"
    },
    "requirements": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "area": {
            "minLength": 1,
            "type": "string"
          },
          "id": {
            "pattern": "^ASET-SEED-[A-Z-]+[0-9]{3}$",
            "type": "string"
          },
          "modality": {
            "enum": [
              "MUST",
              "MUST_NOT",
              "SHOULD",
              "MAY"
            ]
          },
          "predicate": {
            "pattern": "^[a-z][a-z0-9_]+",
            "type": "string"
          },
          "source": {
            "minLength": 1,
            "type": "string"
          },
          "subject": {
            "minLength": 1,
            "type": "string"
          },
          "texts": {
            "$ref": "#/$defs/localized"
          },
          "verification": {
            "items": {
              "type": "string"
            },
            "minItems": 1,
            "type": "array"
          }
        },
        "required": [
          "id",
          "area",
          "modality",
          "subject",
          "predicate",
          "texts",
          "verification",
          "source"
        ],
        "type": "object"
      },
      "minItems": 28,
      "type": "array"
    },
    "schema_version": {
      "const": 2
    },
    "status": {
      "const": "RC12_RELEASE_CANDIDATE_READY"
    },
    "transitions": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "authorization_rule": {
            "type": "string"
          },
          "created_artifacts": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "handler": {
            "type": "string"
          },
          "id": {
            "pattern": "^SEED-TX-[0-9]{3}$",
            "type": "string"
          },
          "kind": {
            "pattern": "^[A-Z_]+$",
            "type": "string"
          },
          "payload_schema": {
            "type": "string"
          },
          "semantic_disposition": {
            "const": "PRESERVED_EXACTLY_FROM_RC11"
          },
          "wire_schema_version": {
            "const": "0.1-rc11"
          }
        },
        "required": [
          "id",
          "kind",
          "payload_schema",
          "handler",
          "authorization_rule",
          "created_artifacts",
          "wire_schema_version",
          "semantic_disposition"
        ],
        "type": "object"
      },
      "maxItems": 18,
      "minItems": 18,
      "type": "array"
    },
    "version": {
      "const": "0.1-rc12"
    }
  },
  "required": [
    "schema_version",
    "model_id",
    "version",
    "status",
    "predecessor",
    "canonicality",
    "languages",
    "publication",
    "concepts",
    "requirements",
    "invariants",
    "transitions",
    "protocol_profile_ref",
    "conformance_profile_ref",
    "assurance",
    "implementation_boundary"
  ],
  "title": "ASET Seed rc12 canonical model",
  "type": "object"
}
