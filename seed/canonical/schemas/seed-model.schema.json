{
  "$defs": {
    "localized": {
      "additionalProperties": false,
      "properties": {
        "en": {
          "minLength": 1,
          "type": "string"
        },
        "pt-BR": {
          "minLength": 1,
          "type": "string"
        },
        "ru": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "ru",
        "en",
        "pt-BR"
      ],
      "type": "object"
    }
  },
  "$id": "https://github.com/attractor-set/ASET/raw/main/seed/canonical/schemas/seed-model.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "assurance": {
      "minProperties": 8,
      "type": "object"
    },
    "canonicality": {
      "minProperties": 8,
      "type": "object"
    },
    "concepts": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "definitions": {
            "$ref": "#/$defs/localized"
          },
          "id": {
            "pattern": "^seed\\.[a-z0-9_]+",
            "type": "string"
          },
          "labels": {
            "$ref": "#/$defs/localized"
          },
          "symbol": {
            "pattern": "^[A-Za-z][A-Za-z0-9]*$",
            "type": "string"
          }
        },
        "required": [
          "id",
          "symbol",
          "labels",
          "definitions"
        ],
        "type": "object"
      },
      "maxItems": 10,
      "minItems": 10,
      "type": "array"
    },
    "conformance_profile_ref": {
      "const": "seed/canonical/conformance/conformance-profile.json"
    },
    "decision_lattice": {
      "additionalProperties": false,
      "properties": {
        "accept_enforcement": {
          "const": "ALLOW"
        },
        "deny_enforcement": {
          "const": "BLOCKED"
        },
        "incomparable": {
          "const": [
            "ACCEPT",
            "DENY"
          ]
        },
        "information_order": {
          "minItems": 2,
          "type": "array"
        },
        "initial": {
          "const": "UNKNOWN"
        },
        "terminal": {
          "const": [
            "ACCEPT",
            "DENY"
          ]
        },
        "unknown_enforcement": {
          "const": "BLOCKED"
        }
      },
      "required": [
        "initial",
        "terminal",
        "information_order",
        "incomparable",
        "unknown_enforcement",
        "deny_enforcement",
        "accept_enforcement"
      ],
      "type": "object"
    },
    "implementation_boundary": {
      "additionalProperties": false,
      "properties": {
        "conformance_protocol_ref": {
          "const": "seed/canonical/conformance/implementation-conformance-protocol.json"
        },
        "implementation_precedence": {
          "const": "NONE"
        },
        "normative_status": {
          "const": "IMPLEMENTATION_NEUTRAL"
        },
        "profile_rule": {
          "minLength": 120,
          "type": "string"
        },
        "required_observables": {
          "items": {
            "type": "string"
          },
          "minItems": 6,
          "type": "array"
        },
        "unspecified_by_seed": {
          "items": {
            "type": "string"
          },
          "minItems": 10,
          "type": "array"
        }
      },
      "required": [
        "normative_status",
        "implementation_precedence",
        "conformance_protocol_ref",
        "required_observables",
        "unspecified_by_seed",
        "profile_rule"
      ],
      "type": "object"
    },
    "invariants": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "id": {
            "pattern": "^SEED-INV-[0-9]{3}$",
            "type": "string"
          },
          "texts": {
            "$ref": "#/$defs/localized"
          },
          "verification": {
            "items": {
              "type": "string"
            },
            "minItems": 1,
            "type": "array"
          }
        },
        "required": [
          "id",
          "texts",
          "verification"
        ],
        "type": "object"
      },
      "maxItems": 12,
      "minItems": 12,
      "type": "array"
    },
    "languages": {
      "const": [
        "ru",
        "en",
        "pt-BR"
      ]
    },
    "model_id": {
      "const": "ASET-SEED-RESOLUTION-CANON-0.2-ALPHA2"
    },
    "predecessor": {
      "minLength": 1,
      "type": "string"
    },
    "protocol_profile_ref": {
      "const": "seed/canonical/protocol/protocol-profile.json"
    },
    "publication": {
      "required": [
        "titles",
        "headings"
      ],
      "type": "object"
    },
    "requirements": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "area": {
            "minLength": 1,
            "type": "string"
          },
          "id": {
            "pattern": "^ASET-SEED-REQ-[0-9]{3}$",
            "type": "string"
          },
          "modality": {
            "enum": [
              "MUST",
              "MUST_NOT",
              "SHOULD",
              "MAY"
            ]
          },
          "predicate": {
            "pattern": "^[a-z][a-z0-9_]+",
            "type": "string"
          },
          "source": {
            "minLength": 1,
            "type": "string"
          },
          "subject": {
            "minLength": 1,
            "type": "string"
          },
          "texts": {
            "$ref": "#/$defs/localized"
          },
          "verification": {
            "items": {
              "type": "string"
            },
            "minItems": 1,
            "type": "array"
          }
        },
        "required": [
          "id",
          "area",
          "modality",
          "subject",
          "predicate",
          "texts",
          "verification",
          "source"
        ],
        "type": "object"
      },
      "maxItems": 14,
      "minItems": 14,
      "type": "array"
    },
    "schema_version": {
      "const": 3
    },
    "status": {
      "const": "RESOLUTION_CORE_ALPHA"
    },
    "transitions": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "authority_rule": {
            "minLength": 1,
            "type": "string"
          },
          "created_artifacts": {
            "items": {
              "type": "string"
            },
            "minItems": 1,
            "type": "array"
          },
          "from_status": {
            "enum": [
              null,
              "UNKNOWN"
            ],
            "type": [
              "string",
              "null"
            ]
          },
          "id": {
            "pattern": "^SEED-TX-[0-9]{3}$",
            "type": "string"
          },
          "kind": {
            "enum": [
              "OPEN_RESOLUTION",
              "RESOLVE_ACCEPT",
              "RESOLVE_DENY",
              "ESCALATE_UNKNOWN"
            ]
          },
          "payload_schema": {
            "type": "string"
          },
          "scope_rule": {
            "minLength": 1,
            "type": "string"
          },
          "terminal": {
            "type": "boolean"
          },
          "to_status": {
            "enum": [
              "UNKNOWN",
              "ACCEPT",
              "DENY"
            ]
          }
        },
        "required": [
          "id",
          "kind",
          "payload_schema",
          "from_status",
          "to_status",
          "authority_rule",
          "scope_rule",
          "created_artifacts",
          "terminal"
        ],
        "type": "object"
      },
      "maxItems": 4,
      "minItems": 4,
      "type": "array"
    },
    "version": {
      "const": "0.2.0-alpha.2"
    }
  },
  "required": [
    "schema_version",
    "model_id",
    "version",
    "status",
    "predecessor",
    "canonicality",
    "languages",
    "publication",
    "decision_lattice",
    "concepts",
    "requirements",
    "invariants",
    "transitions",
    "protocol_profile_ref",
    "conformance_profile_ref",
    "assurance",
    "implementation_boundary"
  ],
  "title": "ASET Seed resolution-core canonical model",
  "type": "object"
}
