{
  "$id": "https://github.com/attractor-set/ASET/raw/main/seed/canonical/schemas/repository-release-gates.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "claim_boundary": {
      "type": "object"
    },
    "document_type": {
      "const": "aset-repository-release-gates"
    },
    "fail_closed": {
      "const": true
    },
    "gates": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "evidence": {
            "type": "string"
          },
          "id": {
            "pattern": "^ASET-GATE-[0-9]{3}$",
            "type": "string"
          },
          "mandatory": {
            "type": "boolean"
          },
          "name": {
            "type": "string"
          }
        },
        "required": [
          "evidence",
          "id",
          "mandatory",
          "name"
        ],
        "type": "object"
      },
      "minItems": 20,
      "type": "array"
    },
    "profile": {
      "const": "ASET_SEED_MINIMAL_STRONG_CORE_ALPHA1"
    },
    "schema_version": {
      "const": 6
    }
  },
  "required": [
    "claim_boundary",
    "document_type",
    "fail_closed",
    "gates",
    "profile",
    "schema_version"
  ],
  "type": "object"
}
