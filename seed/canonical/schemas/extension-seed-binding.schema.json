{
  "$defs": {
    "digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    }
  },
  "$id": "https://github.com/attractor-set/ASET/raw/main/seed/canonical/schemas/extension-seed-binding.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "canon_id": {
      "minLength": 12,
      "type": "string"
    },
    "canon_package_file_digest": {
      "$ref": "#/$defs/digest"
    },
    "canon_package_internal_digest": {
      "$ref": "#/$defs/digest"
    },
    "canon_version": {
      "minLength": 3,
      "type": "string"
    },
    "compatibility": {
      "const": "STRICT_EXTENSION_NO_WEAKENING"
    },
    "document_type": {
      "const": "aset-seed-upstream-binding"
    },
    "extension_conformance_map": {
      "minLength": 8,
      "type": "string"
    },
    "extension_conformance_protocol": {
      "const": "ASET-SEED-EXTENSION-CONFORMANCE-V1"
    },
    "implementation_precedence": {
      "const": "NONE"
    },
    "resolution_conformance_protocol": {
      "const": "ASET-SEED-RESOLUTION-CONFORMANCE-V1"
    },
    "schema_version": {
      "const": 2
    },
    "upstream_ref": {
      "pattern": "^(?:[0-9a-f]{40}|v[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?)$",
      "type": "string"
    },
    "upstream_repository": {
      "const": "https://github.com/attractor-set/ASET"
    }
  },
  "required": [
    "document_type",
    "schema_version",
    "upstream_repository",
    "upstream_ref",
    "canon_id",
    "canon_version",
    "canon_package_file_digest",
    "canon_package_internal_digest",
    "resolution_conformance_protocol",
    "extension_conformance_protocol",
    "extension_conformance_map",
    "compatibility",
    "implementation_precedence"
  ],
  "type": "object"
}
