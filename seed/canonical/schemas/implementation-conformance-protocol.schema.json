{
  "$id": "https://github.com/attractor-set/ASET/raw/main/seed/canonical/schemas/implementation-conformance-protocol.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "document_type": {
      "const": "aset-implementation-conformance-protocol"
    },
    "implementation_precedence": {
      "const": "NONE"
    },
    "normative": {
      "const": true
    },
    "observable_equivalence": {
      "items": {
        "type": "string"
      },
      "minItems": 8,
      "type": "array"
    },
    "operations": {
      "type": "object"
    },
    "protocol_id": {
      "const": "ASET-SEED-RESOLUTION-CONFORMANCE-V3"
    },
    "response_schema_ref": {
      "const": "seed/canonical/schemas/implementation-conformance-envelope.schema.json"
    },
    "schema_version": {
      "const": 3
    },
    "transport": {
      "type": "object"
    },
    "verdict_authority": {
      "minLength": 1,
      "type": "string"
    }
  },
  "required": [
    "document_type",
    "schema_version",
    "protocol_id",
    "normative",
    "implementation_precedence",
    "verdict_authority",
    "observable_equivalence",
    "response_schema_ref",
    "operations",
    "transport"
  ],
  "type": "object"
}
