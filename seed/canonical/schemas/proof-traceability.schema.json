{
  "$id": "https://github.com/attractor-set/ASET/raw/main/seed/canonical/schemas/proof-traceability.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "claim_boundary": {
      "minLength": 1,
      "type": "string"
    },
    "claims": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "formal_projection": {
            "items": {
              "additionalProperties": false,
              "properties": {
                "kind": {
                  "enum": [
                    "STATE_INVARIANT",
                    "TEMPORAL_PROPERTY"
                  ]
                },
                "operator": {
                  "minLength": 1,
                  "type": "string"
                },
                "proof_theorem": {
                  "minLength": 1,
                  "type": "string"
                }
              },
              "required": [
                "kind",
                "operator",
                "proof_theorem"
              ],
              "type": "object"
            },
            "minItems": 0,
            "type": "array"
          },
          "id": {
            "pattern": "^ASET-PROOF-INV-[0-9]{3}$",
            "type": "string"
          },
          "seed_invariants": {
            "items": {
              "pattern": "^SEED-INV-[0-9]{3}$",
              "type": "string"
            },
            "maxItems": 1,
            "minItems": 1,
            "type": "array",
            "uniqueItems": true
          },
          "seed_requirements": {
            "items": {
              "pattern": "^ASET-SEED-REQ-[0-9]{3}$",
              "type": "string"
            },
            "type": "array",
            "uniqueItems": true
          },
          "status": {
            "enum": [
              "PROVED_IN_TLA",
              "PARTIAL_BOUNDARY"
            ]
          },
          "verification_method": {
            "const": "ASET-VERIFY-TLAPS-UNBOUNDED"
          }
        },
        "required": [
          "id",
          "seed_invariants",
          "seed_requirements",
          "status",
          "formal_projection",
          "verification_method"
        ],
        "type": "object"
      },
      "maxItems": 12,
      "minItems": 12,
      "type": "array"
    },
    "document_type": {
      "const": "aset-seed-proof-traceability"
    },
    "formal_model": {
      "const": "seed/canonical/formal/SeedResolution.tla"
    },
    "proof_module": {
      "const": "seed/canonical/formal/SeedResolutionProofs.tla"
    },
    "refinement_status": {
      "const": "STANDALONE_CANON_PROJECTION_EQUIVALENCE_PROVED"
    },
    "schema_version": {
      "const": 2
    },
    "scope": {
      "const": "ABSTRACT_TLA_SAFETY_WITH_EXPLICIT_BOUNDARIES"
    }
  },
  "required": [
    "document_type",
    "schema_version",
    "scope",
    "refinement_status",
    "claim_boundary",
    "formal_model",
    "proof_module",
    "claims"
  ],
  "type": "object"
}
