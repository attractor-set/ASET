{
  "$defs": {
    "actual": {
      "additionalProperties": false,
      "properties": {
        "accepted": {
          "type": "boolean"
        },
        "code": {
          "minLength": 1,
          "type": "string"
        },
        "effect_permitted": {
          "type": "boolean"
        },
        "reason": {
          "maxLength": 100,
          "minLength": 1,
          "type": "string"
        },
        "resolution": {
          "enum": [
            "UNKNOWN",
            "ALLOW",
            "BLOCK"
          ]
        },
        "state_changed": {
          "type": "boolean"
        }
      },
      "required": [
        "accepted",
        "code",
        "state_changed",
        "resolution",
        "effect_permitted",
        "reason"
      ],
      "type": "object"
    },
    "batch_response": {
      "additionalProperties": false,
      "properties": {
        "protocol": {
          "const": "ASET-SEED-RESOLUTION-CONFORMANCE-V3"
        },
        "results": {
          "items": {
            "$ref": "#/$defs/case_result"
          },
          "type": "array"
        }
      },
      "required": [
        "protocol",
        "results"
      ],
      "type": "object"
    },
    "case_result": {
      "additionalProperties": false,
      "properties": {
        "actual": {
          "$ref": "#/$defs/actual"
        },
        "case_id": {
          "minLength": 1,
          "type": "string"
        },
        "final_store": {
          "type": "object"
        },
        "protocol": {
          "const": "ASET-SEED-RESOLUTION-CONFORMANCE-V3"
        }
      },
      "required": [
        "protocol",
        "case_id",
        "actual",
        "final_store"
      ],
      "type": "object"
    },
    "describe_response": {
      "additionalProperties": false,
      "properties": {
        "implementation": {
          "properties": {
            "normative": {
              "const": false
            },
            "profile_id": {
              "minLength": 1,
              "type": "string"
            }
          },
          "required": [
            "profile_id",
            "normative"
          ],
          "type": "object"
        },
        "protocol": {
          "const": "ASET-SEED-RESOLUTION-CONFORMANCE-V3"
        },
        "supported_operations": {
          "allOf": [
            {
              "contains": {
                "const": "describe"
              }
            },
            {
              "contains": {
                "const": "execute_case"
              }
            },
            {
              "contains": {
                "const": "execute_cases"
              }
            }
          ],
          "items": {
            "enum": [
              "describe",
              "execute_case",
              "execute_cases"
            ]
          },
          "type": "array",
          "uniqueItems": true
        }
      },
      "required": [
        "protocol",
        "implementation",
        "supported_operations"
      ],
      "type": "object"
    }
  },
  "$id": "https://github.com/attractor-set/ASET/raw/main/seed/canonical/schemas/implementation-conformance-envelope.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ASET Seed minimal resolution conformance response envelopes"
}
