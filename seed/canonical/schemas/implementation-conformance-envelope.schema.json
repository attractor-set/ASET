{
  "$id": "https://github.com/attractor-set/ASET/raw/main/seed/canonical/schemas/implementation-conformance-envelope.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ASET implementation conformance response envelopes",
  "$defs": {
    "actual": {
      "type": "object",
      "additionalProperties": false,
      "required": ["accepted", "code", "state_changed"],
      "properties": {
        "accepted": {"type": "boolean"},
        "code": {"type": "string", "minLength": 1},
        "state_changed": {"type": "boolean"}
      }
    },
    "case_result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["protocol", "case_id", "actual", "final_state"],
      "properties": {
        "protocol": {"const": "ASET-IMPLEMENTATION-CONFORMANCE-V1"},
        "case_id": {"type": "string", "minLength": 1},
        "actual": {"$ref": "#/$defs/actual"},
        "final_state": {"type": ["object", "null"]}
      }
    },
    "describe_response": {
      "type": "object",
      "additionalProperties": false,
      "required": ["protocol", "implementation", "supported_operations"],
      "properties": {
        "protocol": {"const": "ASET-IMPLEMENTATION-CONFORMANCE-V1"},
        "implementation": {
          "type": "object",
          "required": ["profile_id", "normative"],
          "properties": {
            "profile_id": {"type": "string", "minLength": 1},
            "normative": {"const": false}
          }
        },
        "supported_operations": {
          "type": "array",
          "uniqueItems": true,
          "items": {"enum": ["describe", "execute_case", "execute_cases"]},
          "allOf": [
            {"contains": {"const": "describe"}},
            {"contains": {"const": "execute_case"}},
            {"contains": {"const": "execute_cases"}}
          ]
        }
      }
    },
    "batch_response": {
      "type": "object",
      "additionalProperties": false,
      "required": ["protocol", "results"],
      "properties": {
        "protocol": {"const": "ASET-IMPLEMENTATION-CONFORMANCE-V1"},
        "results": {
          "type": "array",
          "items": {"$ref": "#/$defs/case_result"}
        }
      }
    }
  }
}
