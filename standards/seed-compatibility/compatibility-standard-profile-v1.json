{
  "conformance_claim": {
    "implementation_precedence": "NONE",
    "mandatory_result": "all mandatory conformance cases PASS",
    "must_bind_exact_release": true,
    "must_report": [
      "standard_id",
      "standard_profile_sha256",
      "release_tag",
      "release_commit",
      "seed_semantic_version",
      "canon_id",
      "canonical_package_digest",
      "conformance_protocol",
      "conformance_profile_sha256",
      "cases_passed",
      "cases_total"
    ],
    "verdict_authority": "external ASET conformance runner"
  },
  "distribution": {
    "archive": {
      "compression": "ZIP_STORED",
      "create_system": 3,
      "fixed_timestamp": "1980-01-01T00:00:00Z",
      "format": "zip",
      "path_prefix_template": "ASET-Seed-{release_version}-Conformance-Kit/",
      "preserve_git_mode": true
    },
    "generated_entries": [
      "STANDARD.json",
      "STANDARD-PROFILE.json",
      "STANDARD-SCHEMA.json",
      "KIT-MANIFEST.json",
      "README.md",
      "requirements-conformance.txt"
    ],
    "support_files": [
      "CANONICALITY.md",
      "seed/canonical/CANON_PACKAGE.json",
      "seed/canonical/README.md",
      "tools/run_external_conformance.py",
      "tools/seed_resolution_oracle.py"
    ]
  },
  "document_type": "aset-seed-compatibility-standard-profile",
  "hash_algorithm": "SHA-256",
  "implementation_neutral": true,
  "normative_authority": "The exact machine-readable canon identified by the bound Seed release and CANON_PACKAGE.json. This profile does not alter Seed semantics.",
  "profile_id": "ASET-SEED-COMPATIBILITY-STANDARD-V1",
  "release_binding": {
    "canonical_package_path": "seed/canonical/CANON_PACKAGE.json",
    "conformance_profile_path": "seed/canonical/conformance/conformance-profile.json",
    "implementation_protocol_path": "seed/canonical/conformance/implementation-conformance-protocol.json",
    "release_tag_prefix": "seed-",
    "semantic_source_path": "seed/canonical/source/seed-model.json"
  },
  "runner_dependencies": [
    "jsonschema==4.26.0"
  ],
  "schema_version": 1,
  "standard_series_id": "ASET-SEED-COMPATIBILITY-STANDARD",
  "title": "ASET Seed Compatibility Standard"
}
