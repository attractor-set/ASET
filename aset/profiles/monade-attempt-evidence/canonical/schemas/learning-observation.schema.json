{
  "$id": "https://attractor-set.github.io/ASET/schemas/monade-learning-observation-v1.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "acceptance_decision": {
      "enum": [
        "NOT_DECIDED",
        "REJECTED",
        "ACCEPTED_FOR_RECOGNITION"
      ]
    },
    "authority_effect": {
      "const": "NONE"
    },
    "disposition": {
      "minLength": 1,
      "type": "string"
    },
    "epistemic_status": {
      "enum": [
        "OBSERVED",
        "VERIFIED"
      ]
    },
    "evidence_strength": {
      "enum": [
        "WEAK",
        "MODERATE",
        "STRONG"
      ]
    },
    "master_access": {
      "const": "READ_ONLY"
    },
    "observation_id": {
      "pattern": "^observation-[A-Za-z0-9._:-]+$",
      "type": "string"
    },
    "reason_codes": {
      "items": {
        "pattern": "^[A-Z][A-Z0-9_]*$",
        "type": "string"
      },
      "type": "array",
      "uniqueItems": true
    },
    "rework_required": {
      "type": "boolean"
    },
    "source_attempt_id": {
      "pattern": "^attempt-[A-Za-z0-9._:-]+$",
      "type": "string"
    }
  },
  "required": [
    "observation_id",
    "source_attempt_id",
    "disposition",
    "acceptance_decision",
    "epistemic_status",
    "evidence_strength",
    "reason_codes",
    "master_access",
    "authority_effect"
  ],
  "title": "ASET Monade Learning Observation Projection",
  "type": "object"
}
