  "operations": [
    {
      "classification": "NORMATIVE_DECISION",
      "description": {
        "en": "Create a CoreResolution without rewriting the submitted document.",
        "pt-BR": "Produz uma resolução normativa para o documento exato e o gate especificado.",
        "ru": "Формирует нормативное решение для точного документа и заданного gate."
      },
      "id": "CORE-RESOLVE",
      "input_artifacts": [
        "GateSubmissionFamily"
      ],
      "name": "ResolveSubmission",
      "output_artifacts": [
        "CoreResolution"
      ],
      "seed_mapping": {
        "justification": "The operation changes governed state, authority, evidence, or external-effect status and therefore uses the declared Seed sequence.",
        "outcome_recognition_required": false,
        "seed_transition_required": true,
        "sequence": [
          "Decision"
        ]
      }
    },
    {
      "classification": "AUTHORIZATION_ISSUANCE",
      "description": {
        "en": "Issue one exact one-shot Permit only after a PERMITTED resolution.",
        "pt-BR": "Emite um Permit de uso único somente após uma resolução normativa permissiva.",
        "ru": "Выдаёт одноразовый Permit только после разрешающего нормативного решения."
      },
      "id": "CORE-ISSUE-PERMIT",
      "input_artifacts": [
        "CoreResolution"
      ],
      "name": "IssuePermit",
      "output_artifacts": [
        "OneShotPermitClosedUnion"
      ],
      "seed_mapping": {
        "justification": "The operation changes governed state, authority, evidence, or external-effect status and therefore uses the declared Seed sequence.",
        "outcome_recognition_required": false,
        "seed_transition_required": true,
        "sequence": [
          "Decision",
          "Permit"
        ]
      }
    },
    {
      "classification": "GOVERNED_CONTEXT_MUTATION",
      "description": {
        "en": "Atomically apply the patch, compare-and-swap scoped heads, consume the Permit, and emit a receipt.",
        "pt-BR": "Consome o Permit atomicamente, aplica o patch e cria o recibo do cruzamento.",
        "ru": "Атомарно потребляет Permit, применяет patch и создаёт receipt пересечения."
      },
      "id": "CORE-CROSS",
      "input_artifacts": [
        "CoreResolution",
        "OneShotPermitClosedUnion",
        "ContextPatchSet"
      ],
      "name": "LinearizeCrossing",
