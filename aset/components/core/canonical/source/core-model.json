  "invariants": [
    {
      "id": "INV-AUTH-001",
      "statement": "Только ASET Core создаёт authority-bearing Permit."
    },
    {
      "id": "INV-AUTH-002",
      "statement": "Всё, что не имеет действующего Permit для точного гейта, запрещено."
    },
    {
      "id": "INV-AUTH-003",
      "statement": "CoreResolution имеет только PERMITTED или PROHIBITED; техническая ошибка не является разрешением."
    },
    {
      "id": "INV-CORE-RES-001",
      "statement": "PERMITTED requires exactly one permit reference and digest; PROHIBITED forbids both and requires reason codes."
    },
    {
      "id": "INV-PERMIT-001",
      "statement": "Permit относится ровно к одному document digest, dependency context set, gate instance, crossing ID и actor/execution ID."
    },
    {
      "id": "INV-PERMIT-002",
      "statement": "Permit допускает ровно одно немедленное пересечение и после него безвозвратно CONSUMED."
    },
    {
      "id": "INV-PERMIT-003",
      "statement": "Permit одного гейта неприменим к другому гейту."
    },
    {
      "id": "INV-PERMIT-004",
      "statement": "ExpectationPermit не разрешает внешний эффект; ExecutionPermit является отдельным артефактом."
    },
    {
      "id": "INV-PERMIT-005",
      "statement": "Every Permit has consume_before strictly later than issued_at and within the policy maximum lifetime of 60 seconds."
    }
  ],
