@prefix aset: <https://w3id.org/aset/component/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

aset:aset_coreScheme a skos:ConceptScheme ;
    skos:prefLabel "aset.core terminology"@en .

aset:AuthorityGraph a skos:Concept ;
    skos:inScheme aset:aset_coreScheme ;
    skos:notation "AuthorityGraph" ;
    skos:prefLabel "AuthorityGraph"@ru ;
    skos:prefLabel "AuthorityGraph"@en ;
    skos:prefLabel "AuthorityGraph"@pt-BR ;
    skos:definition "Normative concept owned by aset.core."@en .

aset:CoreResolution a skos:Concept ;
    skos:inScheme aset:aset_coreScheme ;
    skos:notation "CoreResolution" ;
    skos:prefLabel "CoreResolution"@ru ;
    skos:prefLabel "CoreResolution"@en ;
    skos:prefLabel "CoreResolution"@pt-BR ;
    skos:definition "Normative concept owned by aset.core."@en .

aset:GateCrossingReceipt a skos:Concept ;
    skos:inScheme aset:aset_coreScheme ;
    skos:notation "GateCrossingReceipt" ;
    skos:prefLabel "GateCrossingReceipt"@ru ;
    skos:prefLabel "GateCrossingReceipt"@en ;
    skos:prefLabel "GateCrossingReceipt"@pt-BR ;
    skos:definition "Normative concept owned by aset.core."@en .

aset:GateKernel a skos:Concept ;
    skos:inScheme aset:aset_coreScheme ;
    skos:notation "GateKernel" ;
    skos:prefLabel "GateKernel"@ru ;
    skos:prefLabel "GateKernel"@en ;
    skos:prefLabel "GateKernel"@pt-BR ;
    skos:definition "Normative concept owned by aset.core."@en .

aset:NormativeLedger a skos:Concept ;
    skos:inScheme aset:aset_coreScheme ;
    skos:notation "NormativeLedger" ;
    skos:prefLabel "NormativeLedger"@ru ;
    skos:prefLabel "NormativeLedger"@en ;
    skos:prefLabel "NormativeLedger"@pt-BR ;
    skos:definition "Normative concept owned by aset.core."@en .

aset:OneShotPermit a skos:Concept ;
    skos:inScheme aset:aset_coreScheme ;
    skos:notation "OneShotPermit" ;
    skos:prefLabel "OneShotPermit"@ru ;
    skos:prefLabel "OneShotPermit"@en ;
    skos:prefLabel "OneShotPermit"@pt-BR ;
    skos:definition "Normative concept owned by aset.core."@en .

aset:PolicySet a skos:Concept ;
    skos:inScheme aset:aset_coreScheme ;
    skos:notation "PolicySet" ;
    skos:prefLabel "PolicySet"@ru ;
    skos:prefLabel "PolicySet"@en ;
    skos:prefLabel "PolicySet"@pt-BR ;
    skos:definition "Normative concept owned by aset.core."@en .

aset:CORE_RESOLVE a skos:Concept ;
    skos:inScheme aset:aset_coreScheme ;
    skos:notation "CORE-RESOLVE" ;
    skos:prefLabel "ResolveSubmission"@ru ;
    skos:prefLabel "ResolveSubmission"@en ;
    skos:prefLabel "ResolveSubmission"@pt-BR ;
    skos:definition "Create a CoreResolution without rewriting the submitted document."@en .

aset:CORE_ISSUE_PERMIT a skos:Concept ;
    skos:inScheme aset:aset_coreScheme ;
    skos:notation "CORE-ISSUE-PERMIT" ;
    skos:prefLabel "IssuePermit"@ru ;
    skos:prefLabel "IssuePermit"@en ;
    skos:prefLabel "IssuePermit"@pt-BR ;
    skos:definition "Issue one exact one-shot Permit only after a PERMITTED resolution."@en .

aset:CORE_CROSS a skos:Concept ;
    skos:inScheme aset:aset_coreScheme ;
    skos:notation "CORE-CROSS" ;
    skos:prefLabel "LinearizeCrossing"@ru ;
    skos:prefLabel "LinearizeCrossing"@en ;
    skos:prefLabel "LinearizeCrossing"@pt-BR ;
    skos:definition "Atomically apply the patch, compare-and-swap scoped heads, consume the Permit, and emit a receipt."@en .
