      "input_artifacts": [],
      "name": "ComposeContext",
      "output_artifacts": [
        "CompositeContextManifest"
      ],
      "seed_mapping": {
        "justification": "Mapped by operation class to ASET Seed 0.1-rc12; local computations create no authority or recognized Outcome.",
        "outcome_recognition_required": false,
        "seed_transition_required": false,
        "sequence": []
      }
    },
    {
      "classification": "GOVERNED_CONTEXT_MUTATION",
      "description": {
        "en": "Create a new context version from an authorized atomic patch set.",
        "pt-BR": "Cria uma nova versão do contexto por meio de um conjunto atômico de alterações autorizado.",
        "ru": "Создаёт новую версию контекста посредством разрешённого атомарного набора изменений."
      },
      "id": "CTX-APPLY-PATCH",
      "input_artifacts": [
        "ContextPatchSet"
      ],
      "name": "ApplyAuthorizedPatch",
      "output_artifacts": [
        "SignedContextComponent",
        "CompositeContextManifest"
      ],
      "seed_mapping": {
        "justification": "The operation changes governed state, authority, evidence, or external-effect status and therefore uses the declared Seed sequence.",
        "outcome_recognition_required": false,
        "seed_transition_required": true,
        "sequence": [
          "Decision",
          "Permit",
          "PermitUseReceipt"
        ]
      }
    }
  ],
