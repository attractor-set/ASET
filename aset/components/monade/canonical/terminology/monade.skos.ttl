    skos:notation "AcceptanceContract" ;
    skos:prefLabel "AcceptanceContract"@ru ;
    skos:prefLabel "AcceptanceContract"@en ;
    skos:prefLabel "AcceptanceContract"@pt-BR ;
    skos:definition "Normative concept owned by aset.monade."@en .

