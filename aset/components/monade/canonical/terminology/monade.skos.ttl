@prefix aset: <https://w3id.org/aset/component/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

aset:aset_monadeScheme a skos:ConceptScheme ;
    skos:prefLabel "aset.monade terminology"@en .

