    skos:prefLabel "DispatchExecution"@ru ;
    skos:prefLabel "DispatchExecution"@en ;
    skos:prefLabel "DispatchExecution"@pt-BR ;
    skos:definition "Dispatch one externally effective execution through an outbox boundary."@en .

