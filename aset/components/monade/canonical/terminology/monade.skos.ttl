aset:MON_PROJECT a skos:Concept ;
    skos:inScheme aset:aset_monadeScheme ;
    skos:notation "MON-PROJECT" ;
    skos:prefLabel "AdmitContextProjection"@ru ;
    skos:prefLabel "AdmitContextProjection"@en ;
    skos:prefLabel "AdmitContextProjection"@pt-BR ;
    skos:definition "Admit a scoped Memory projection into Task context."@en .

aset:MON_BIND a skos:Concept ;
    skos:inScheme aset:aset_monadeScheme ;
    skos:notation "MON-BIND" ;
    skos:prefLabel "BindExecution"@ru ;
    skos:prefLabel "BindExecution"@en ;
    skos:prefLabel "BindExecution"@pt-BR ;
    skos:definition "Bind authorized expected change to one operational execution."@en .

