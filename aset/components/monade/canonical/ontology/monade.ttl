@prefix aset: <https://w3id.org/aset/component/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

aset:Component a rdfs:Class .
aset:Operation a rdfs:Class .
aset:owns a rdf:Property .
aset:mapsToSeed a rdf:Property .

aset:aset_monade a aset:Component ;
    rdfs:label "aset.monade" ;
    aset:owns aset:AcceptanceContract, aset:AcceptanceDecision, aset:EphemeralExecutionState, aset:EvidenceBundle, aset:ExecutionIntent, aset:ExecutionObservation, aset:OperationalBinding, aset:OutboxCommand, aset:Outcome, aset:PlanRevision, aset:ProjectionProfile, aset:PromptManifest, aset:Task, aset:TaskAcceptance, aset:TokenBudgetPlan, aset:ToolInvocation, aset:TransitionGraph, aset:VerificationReceipt, aset:VerificationVerdict, aset:VerifierAdapter, aset:WorkerEnvelope, aset:WorkerObservation .

aset:MON_PROJECT a aset:Operation ;
    rdfs:label "AdmitContextProjection" ;
    aset:mapsToSeed "Decision -> Permit -> PermitUseReceipt" .

aset:MON_BIND a aset:Operation ;
    rdfs:label "BindExecution" ;
    aset:mapsToSeed "Decision -> Permit -> PermitUseReceipt" .

aset:MON_DISPATCH a aset:Operation ;
    rdfs:label "DispatchExecution" ;
    aset:mapsToSeed "Decision -> Permit -> PermitUseReceipt -> ExecutionIntent -> Observation -> Verification -> Outcome" .

aset:MON_OBSERVE a aset:Operation ;
    rdfs:label "AdmitObservation" ;
    aset:mapsToSeed "Decision -> Permit -> PermitUseReceipt -> Observation" .

aset:MON_VERIFY a aset:Operation ;
    rdfs:label "VerifyEvidence" ;
    aset:mapsToSeed "Decision -> Permit -> PermitUseReceipt -> Observation -> Verification" .

aset:MON_CLOSE a aset:Operation ;
    rdfs:label "CloseTask" ;
    aset:mapsToSeed "Decision -> Permit -> PermitUseReceipt -> Observation -> Verification -> Outcome" .

aset:MON_RETRY a aset:Operation ;
    rdfs:label "RetryExecution" ;
    aset:mapsToSeed "Decision -> Permit -> PermitUseReceipt -> ExecutionIntent -> Observation -> Verification -> Outcome" .

aset:MON_COMPENSATE a aset:Operation ;
    rdfs:label "CompensateExecution" ;
    aset:mapsToSeed "Decision -> Permit -> PermitUseReceipt -> ExecutionIntent -> Observation -> Verification -> Outcome" .
