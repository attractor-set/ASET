@prefix aset: <https://w3id.org/aset/component/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

aset:aset_protocolScheme a skos:ConceptScheme ;
    skos:prefLabel "aset.protocol terminology"@en .

aset:CanonicalEnvelope a skos:Concept ;
    skos:inScheme aset:aset_protocolScheme ;
    skos:notation "CanonicalEnvelope" ;
    skos:prefLabel "CanonicalEnvelope"@ru ;
    skos:prefLabel "CanonicalEnvelope"@en ;
    skos:prefLabel "CanonicalEnvelope"@pt-BR ;
    skos:definition "Normative concept owned by aset.protocol."@en .

aset:ErrorEnvelope a skos:Concept ;
    skos:inScheme aset:aset_protocolScheme ;
    skos:notation "ErrorEnvelope" ;
    skos:prefLabel "ErrorEnvelope"@ru ;
    skos:prefLabel "ErrorEnvelope"@en ;
    skos:prefLabel "ErrorEnvelope"@pt-BR ;
    skos:definition "Normative concept owned by aset.protocol."@en .

aset:SchemaRegistry a skos:Concept ;
    skos:inScheme aset:aset_protocolScheme ;
    skos:notation "SchemaRegistry" ;
    skos:prefLabel "SchemaRegistry"@ru ;
    skos:prefLabel "SchemaRegistry"@en ;
    skos:prefLabel "SchemaRegistry"@pt-BR ;
    skos:definition "Normative concept owned by aset.protocol."@en .

aset:SignatureProfile a skos:Concept ;
    skos:inScheme aset:aset_protocolScheme ;
    skos:notation "SignatureProfile" ;
    skos:prefLabel "SignatureProfile"@ru ;
    skos:prefLabel "SignatureProfile"@en ;
    skos:prefLabel "SignatureProfile"@pt-BR ;
    skos:definition "Normative concept owned by aset.protocol."@en .

aset:PROTO_VALIDATE a skos:Concept ;
    skos:inScheme aset:aset_protocolScheme ;
    skos:notation "PROTO-VALIDATE" ;
    skos:prefLabel "ValidateArtifact"@ru ;
    skos:prefLabel "ValidateArtifact"@en ;
    skos:prefLabel "ValidateArtifact"@pt-BR ;
    skos:definition "Validate a normative artifact with its exact closed-world schema."@en .

aset:PROTO_CANON a skos:Concept ;
    skos:inScheme aset:aset_protocolScheme ;
    skos:notation "PROTO-CANON" ;
    skos:prefLabel "CanonicalizeArtifact"@ru ;
    skos:prefLabel "CanonicalizeArtifact"@en ;
    skos:prefLabel "CanonicalizeArtifact"@pt-BR ;
    skos:definition "Produce ASET-JCS-1 canonical bytes and digest without business decisions."@en .
