  "invariants": [
    {
      "id": "INV-CORPUS-001",
      "statement": "The positive conformance corpus forms an end-to-end digest-linked signed artifact graph; unresolved or substituted internal references are prohibited."
    },
    {
      "id": "INV-CORPUS-002",
      "statement": "Each one-shot Permit in the positive corpus resolves to one exact signed CoreResolution that binds the exact Submission and Permit digest."
    },
    {
      "id": "INV-CRYPTO-001",
      "statement": "ASET-JCS-1 canonical bytes, SHA-256 digests and Ed25519 signatures are verified against reproducible positive and negative vectors."
    },
    {
      "id": "INV-CRYPTO-002",
      "statement": "Signed normative JSON values prohibit non-integer numbers unless a future version defines and tests a complete cross-language numeric canonicalization profile."
    },
    {
      "id": "INV-CRYPTO-003",
      "statement": "ASET-JCS-1 permits only I-JSON safe integers and sorts NFC-normalized object keys by unsigned UTF-8 bytes using published cross-language edge vectors."
    },
    {
      "id": "INV-ID-001",
      "statement": "Every stable ID in the normative machine model is globally unique; conflicting duplicate identities are prohibited."
    },
    {
      "id": "INV-ID-002",
      "statement": "Every primary identity in requirements, ADR, verification, model, diagram, conformance, oracle, document and key registries is unique in its declared registry."
    },
    {
      "id": "INV-JSON-001",
      "statement": "Every normative JSON input rejects duplicate raw member names before semantic parsing, schema validation, digesting or signature verification."
    },
    {
      "id": "INV-SCHEMA-001",
      "statement": "Every normative JSON artifact is validated by a closed-world schema with unknown properties rejected."
    },
    {
      "id": "INV-SCHEMA-002",
      "statement": "All 11 gates have distinct submission, Permit and patch schemas; a document valid for one role is invalid for every incompatible role."
    },
    {
      "id": "INV-SCHEMA-003",
      "statement": "The externally signed freeze profile binds the path, schema $id, byte SHA-256 and canonical digest of every mandatory normative JSON Schema before any schema is used."
    }
  ],
