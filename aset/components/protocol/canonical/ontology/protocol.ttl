@prefix aset: <https://w3id.org/aset/component/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

aset:Component a rdfs:Class .
aset:Operation a rdfs:Class .
aset:owns a rdf:Property .
aset:mapsToSeed a rdf:Property .

aset:aset_protocol a aset:Component ;
    rdfs:label "aset.protocol" ;
    aset:owns aset:CanonicalEnvelope, aset:ErrorEnvelope, aset:SchemaRegistry, aset:SignatureProfile .

aset:PROTO_VALIDATE a aset:Operation ;
    rdfs:label "ValidateArtifact" ;
    aset:mapsToSeed "none" .

aset:PROTO_CANON a aset:Operation ;
    rdfs:label "CanonicalizeArtifact" ;
    aset:mapsToSeed "none" .
