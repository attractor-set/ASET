{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aset.local/schemas/1.5-rc11/release-envelope.schema.json",
  "title": "ASET Out-of-Band Release Envelope",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "document_type",
    "envelope_id",
    "version",
    "archive",
    "entry_manifest",
    "freeze_profile_digest",
    "trust_anchor_id",
    "canonical_digest",
    "integrity"
  ],
  "properties": {
    "document_type": {
      "const": "aset.release-envelope"
    },
    "envelope_id": {
      "const": "aset.release-envelope.rc11"
    },
    "version": {
      "const": "1.5-rc11"
    },
    "archive": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "size",
        "sha256"
      ],
      "properties": {
        "name": {
          "const": "ASET-Documentation-Freeze-Candidate-v1.5-rc11.zip"
        },
        "size": {
          "type": "integer",
          "minimum": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      }
    },
    "entry_manifest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "count",
        "entries",
        "digest"
      ],
      "properties": {
        "count": {
          "type": "integer",
          "minimum": 1
        },
        "entries": {
          "type": "array",
          "minItems": 1
        },
        "digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      }
    },
    "freeze_profile_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "trust_anchor_id": {
      "const": "aset.external-freeze-trust-anchor.rc11"
    },
    "canonical_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "integrity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "algorithm",
        "key_id",
        "signed_envelope_digest",
        "signature"
      ],
      "properties": {
        "algorithm": {
          "const": "Ed25519"
        },
        "key_id": {
          "const": "key:aset:freeze-authority:rc11"
        },
        "signed_envelope_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "signature": {
          "type": "string",
          "pattern": "^ed25519:[A-Za-z0-9_-]+$"
        }
      }
    }
  }
}
