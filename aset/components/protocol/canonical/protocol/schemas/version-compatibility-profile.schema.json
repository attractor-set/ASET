{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aset.local/schemas/1.5-rc11/version-compatibility-profile.schema.json",
  "title": "ASET Version Compatibility Profile",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "document_type",
    "profile_id",
    "package_version",
    "documentation_profile_version",
    "protocol_version",
    "schema_profile_version",
    "key_epoch",
    "release_layer_schema_versions",
    "compatibility_mode",
    "rules"
  ],
  "properties": {
    "document_type": {
      "const": "aset.version-compatibility-profile"
    },
    "profile_id": {
      "const": "aset.version-profile.rc11"
    },
    "package_version": {
      "const": "1.5-rc11"
    },
    "documentation_profile_version": {
      "const": "1.5-rc11"
    },
    "protocol_version": {
      "const": "1.5-rc8"
    },
    "schema_profile_version": {
      "const": "1.5-rc8"
    },
    "key_epoch": {
      "const": "1.5-rc8"
    },
    "release_layer_schema_versions": {
      "type": "array",
      "const": [
        "1.5-rc11"
      ]
    },
    "compatibility_mode": {
      "const": "PROTOCOL_UNCHANGED_DOCUMENTATION_AND_ASSURANCE_HARDENING"
    },
    "rules": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "positive_artifact_schema_version",
        "positive_index_version",
        "negative_index_version",
        "oracle_registry_version",
        "key_registry_version",
        "core_protocol_schema_id_suffix",
        "release_layer_schema_id_suffix"
      ],
      "properties": {
        "positive_artifact_schema_version": {
          "const": "1.5-rc8"
        },
        "positive_index_version": {
          "const": "1.5-rc8"
        },
        "negative_index_version": {
          "const": "1.5-rc8"
        },
        "oracle_registry_version": {
          "const": "1.5-rc8"
        },
        "key_registry_version": {
          "const": "1.5-rc8"
        },
        "core_protocol_schema_id_suffix": {
          "const": "1.5-rc8"
        },
        "release_layer_schema_id_suffix": {
          "const": "1.5-rc11"
        }
      }
    }
  }
}
