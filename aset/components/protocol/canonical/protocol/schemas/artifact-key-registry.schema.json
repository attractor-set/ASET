{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aset.local/schemas/1.5-rc8/artifact-key-registry.schema.json",
  "title": "ASET Artifact Key Registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "purpose", "trust_epoch", "lifecycle_states", "keys"],
  "properties": {
    "version": {"const": "1.5-rc8"},
    "purpose": {"const": "CONFORMANCE_ONLY"},
    "trust_epoch": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
    "lifecycle_states": {"const": ["ACTIVE", "SUSPENDED", "REVOKED", "EXPIRED"]},
    "keys": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["key_id", "issuer", "algorithm", "public_key_hex", "status", "allowed_issuers", "allowed_artifact_types", "valid_from_epoch", "revocation_epoch"],
        "properties": {
          "key_id": {"type": "string", "pattern": "^key:aset:rc8:[a-z0-9-]+$"},
          "issuer": {"type": "string", "minLength": 1},
          "algorithm": {"const": "Ed25519"},
          "public_key_hex": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "status": {"enum": ["ACTIVE", "SUSPENDED", "REVOKED", "EXPIRED"]},
          "allowed_issuers": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "allowed_artifact_types": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^aset\\."}},
          "valid_from_epoch": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
          "revocation_epoch": {"type": ["integer", "null"], "minimum": 0, "maximum": 9007199254740991}
        }
      }
    }
  }
}
