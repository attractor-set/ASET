{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aset.local/schemas/1.5-rc11/final-output-manifest.schema.json",
  "title": "ASET Final Output Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "file_count",
    "files",
    "manifest_digest",
    "docx_policy",
    "pdf_policy",
    "clean_room_mode"
  ],
  "properties": {
    "file_count": {
      "type": "integer",
      "minimum": 1
    },
    "files": {
      "type": "array",
      "minItems": 1
    },
    "manifest_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "docx_policy": {
      "type": "object"
    },
    "pdf_policy": {
      "type": "object"
    },
    "clean_room_mode": {
      "const": "EXACT_BYTES"
    }
  }
}
