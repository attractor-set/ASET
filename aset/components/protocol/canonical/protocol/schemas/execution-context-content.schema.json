{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:aset:schema:execution-context-content:1.5-rc8",
  "title": "execution context content",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "execution_refs",
    "outbox_refs"
  ],
  "properties": {
    "execution_refs": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,127}$"
      }
    },
    "outbox_refs": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,127}$"
      }
    },
    "observation_refs": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,127}$"
      }
    }
  }
}
