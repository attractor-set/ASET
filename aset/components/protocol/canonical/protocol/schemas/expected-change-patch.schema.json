{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:aset:schema:aset.expected-change-patch:1.5-rc8",
  "title": "ExpectedChangePatch",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "document_type",
    "schema_version",
    "document_id",
    "tenant_id",
    "issued_at",
    "issuer",
    "integrity",
    "patch_type",
    "source_context_root",
    "target_component_type",
    "claims",
    "external_effect_asserted",
    "preserved_invariants",
    "acceptance_intent_refs"
  ],
  "properties": {
    "document_type": {
      "const": "aset.expected-change-patch"
    },
    "schema_version": {
      "const": "1.5-rc8"
    },
    "document_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,127}$"
    },
    "tenant_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,127}$"
    },
    "issued_at": {
      "type": "string",
      "format": "date-time"
    },
    "issuer": {
      "const": "aset-master"
    },
    "integrity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "canonicalization",
        "digest_algorithm",
        "document_digest",
        "signature_profile",
        "key_id",
        "signature"
      ],
      "properties": {
        "canonicalization": {
          "const": "ASET-JCS-1"
        },
        "digest_algorithm": {
          "const": "SHA-256"
        },
        "document_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "signature_profile": {
          "const": "Ed25519-SHA256-v1"
        },
        "key_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,127}$"
        },
        "signature": {
          "type": "string",
          "pattern": "^ed25519:[A-Za-z0-9_-]{86}$"
        }
      }
    },
    "patch_type": {
      "const": "ExpectedChangePatch"
    },
    "source_context_root": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "target_component_type": {
      "enum": [
        "master",
        "task"
      ]
    },
    "claims": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "claim_id",
          "status"
        ],
        "properties": {
          "claim_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,127}$"
          },
          "status": {
            "enum": [
              "EXPECTED",
              "ASSERTED",
              "OBSERVED",
              "VERIFIED",
              "REJECTED",
              "PARTIAL",
              "UNKNOWN"
            ]
          },
          "value": {
            "$ref": "#/$defs/integerJsonValue"
          },
          "subject": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,127}$"
          },
          "predicate": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,127}$"
          },
          "from_value": {
            "$ref": "#/$defs/integerJsonValue"
          },
          "to_value": {
            "$ref": "#/$defs/integerJsonValue"
          },
          "verdict": {
            "enum": [
              "VERIFIED",
              "REJECTED",
              "PARTIAL",
              "UNKNOWN"
            ]
          }
        }
      }
    },
    "external_effect_asserted": {
      "const": false
    },
    "preserved_invariants": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,127}$"
      }
    },
    "acceptance_intent_refs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,127}$"
      }
    }
  },
  "$defs": {
    "integerJsonValue": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "boolean"
        },
        {
          "type": "string"
        },
        {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/integerJsonValue"
          }
        },
        {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/integerJsonValue"
          }
        }
      ]
    }
  }
}
