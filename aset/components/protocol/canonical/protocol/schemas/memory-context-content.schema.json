{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:aset:schema:memory-context-content:1.5-rc8",
  "title": "memory context content",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "facts",
    "provenance_refs"
  ],
  "properties": {
    "facts": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,127}$"
      }
    },
    "provenance_refs": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,127}$"
      }
    },
    "open_contradictions": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,127}$"
      }
    }
  }
}
