{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aset.local/schemas/1.5-rc11/toolchain-lock.schema.json",
  "title": "ASET Exact Toolchain Lock",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "document_type",
    "lock_id",
    "version",
    "python",
    "python_distributions",
    "native_tools",
    "policy",
    "environment_digest",
    "runtime_closure"
  ],
  "properties": {
    "document_type": {
      "const": "aset.toolchain-lock"
    },
    "lock_id": {
      "const": "aset.toolchain-lock.rc11"
    },
    "version": {
      "const": "1.5-rc11"
    },
    "python": {
      "type": "object"
    },
    "python_distributions": {
      "type": "array",
      "minItems": 1
    },
    "native_tools": {
      "type": "array",
      "minItems": 2
    },
    "policy": {
      "type": "object"
    },
    "environment_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "runtime_closure": {
      "type": "object"
    }
  }
}
