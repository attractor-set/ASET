{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:aset:schema:aset.context-patch-set:1.5-rc8",
  "title": "Atomic Context Patch Set",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "document_type",
    "schema_version",
    "document_id",
    "tenant_id",
    "issued_at",
    "issuer",
    "integrity",
    "source_context_root",
    "gate",
    "permit_ref",
    "permit_digest",
    "atomicity",
    "component_patches",
    "resulting_component_refs",
    "resulting_context_root"
  ],
  "properties": {
    "document_type": {
      "const": "aset.context-patch-set"
    },
    "schema_version": {
      "const": "1.5-rc8"
    },
    "document_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,127}$"
    },
    "tenant_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,127}$"
    },
    "issued_at": {
      "type": "string",
      "format": "date-time"
    },
    "issuer": {
      "const": "aset-gate-kernel"
    },
    "integrity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "canonicalization",
        "digest_algorithm",
        "document_digest",
        "signature_profile",
        "key_id",
        "signature"
      ],
      "properties": {
        "canonicalization": {
          "const": "ASET-JCS-1"
        },
        "digest_algorithm": {
          "const": "SHA-256"
        },
        "document_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "signature_profile": {
          "const": "Ed25519-SHA256-v1"
        },
        "key_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,127}$"
        },
        "signature": {
          "type": "string",
          "pattern": "^ed25519:[A-Za-z0-9_-]{86}$"
        }
      }
    },
    "source_context_root": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "gate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "gate_type",
        "gate_instance_id",
        "crossing_id"
      ],
      "properties": {
        "gate_type": {
          "enum": [
            "GATE-CONTEXT-PROJECT",
            "GATE-EXPECT-ADMIT",
            "GATE-EXEC-BIND",
            "GATE-DISPATCH",
            "GATE-OBSERVE",
            "GATE-EVIDENCE",
            "GATE-ACCEPT",
            "GATE-RETRY",
            "GATE-COMPENSATE",
            "GATE-TASK-CLOSE",
            "GATE-MEM-MUTATE"
          ]
        },
        "gate_instance_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,127}$"
        },
        "crossing_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,127}$"
        }
      }
    },
    "permit_ref": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,127}$"
    },
    "permit_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "atomicity": {
      "const": "ALL_OR_NOTHING"
    },
    "component_patches": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "component_type",
          "component_id",
          "owner_id",
          "source_digest",
          "patch_document_ref",
          "patch_document_digest",
          "operations"
        ],
        "properties": {
          "component_type": {
            "enum": [
              "memory",
              "master",
              "task",
              "execution",
              "acceptance",
              "authority"
            ]
          },
          "component_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,127}$"
          },
          "owner_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,127}$"
          },
          "source_digest": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          },
          "patch_document_ref": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,127}$"
          },
          "patch_document_digest": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          },
          "operations": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "op",
                "claim_id",
                "claim_document_ref"
              ],
              "properties": {
                "op": {
                  "const": "APPEND_CLAIM"
                },
                "claim_id": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,127}$"
                },
                "claim_document_ref": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,127}$"
                }
              }
            }
          }
        }
      }
    },
    "resulting_component_refs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "component_type",
          "component_id",
          "version",
          "digest",
          "owner_id",
          "owner_key_id"
        ],
        "properties": {
          "component_type": {
            "enum": [
              "memory",
              "master",
              "task",
              "execution",
              "acceptance",
              "authority"
            ]
          },
          "component_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,127}$"
          },
          "version": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "digest": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          },
          "owner_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,127}$"
          },
          "owner_key_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,127}$"
          }
        }
      }
    },
    "resulting_context_root": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  }
}
