{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:aset:schema:aset.core-resolution:1.5-rc8",
  "title": "Core Resolution",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "document_type",
    "schema_version",
    "document_id",
    "tenant_id",
    "issued_at",
    "issuer",
    "integrity",
    "submission_ref",
    "gate",
    "verdict",
    "basis"
  ],
  "properties": {
    "document_type": {
      "const": "aset.core-resolution"
    },
    "schema_version": {
      "const": "1.5-rc8"
    },
    "document_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,127}$"
    },
    "tenant_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,127}$"
    },
    "issued_at": {
      "type": "string",
      "format": "date-time"
    },
    "issuer": {
      "const": "aset-core"
    },
    "integrity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "canonicalization",
        "digest_algorithm",
        "document_digest",
        "signature_profile",
        "key_id",
        "signature"
      ],
      "properties": {
        "canonicalization": {
          "const": "ASET-JCS-1"
        },
        "digest_algorithm": {
          "const": "SHA-256"
        },
        "document_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "signature_profile": {
          "const": "Ed25519-SHA256-v1"
        },
        "key_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,127}$"
        },
        "signature": {
          "type": "string",
          "pattern": "^ed25519:[A-Za-z0-9_-]{86}$"
        }
      }
    },
    "submission_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "document_id",
        "document_digest"
      ],
      "properties": {
        "document_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,127}$"
        },
        "document_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      }
    },
    "gate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "gate_type",
        "gate_instance_id",
        "crossing_id"
      ],
      "properties": {
        "gate_type": {
          "enum": [
            "GATE-CONTEXT-PROJECT",
            "GATE-EXPECT-ADMIT",
            "GATE-EXEC-BIND",
            "GATE-DISPATCH",
            "GATE-OBSERVE",
            "GATE-EVIDENCE",
            "GATE-ACCEPT",
            "GATE-RETRY",
            "GATE-COMPENSATE",
            "GATE-TASK-CLOSE",
            "GATE-MEM-MUTATE"
          ]
        },
        "gate_instance_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,127}$"
        },
        "crossing_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,127}$"
        }
      }
    },
    "verdict": {
      "enum": [
        "PERMITTED",
        "PROHIBITED"
      ]
    },
    "basis": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "policy_set_digest",
        "authority_epoch",
        "evidence_digests"
      ],
      "properties": {
        "policy_set_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "authority_epoch": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "evidence_digests": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          }
        }
      }
    },
    "permit_ref": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,127}$"
    },
    "permit_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "reason_codes": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[A-Z][A-Z0-9_]{2,63}$"
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "verdict": {
            "const": "PERMITTED"
          }
        }
      },
      "then": {
        "required": [
          "permit_ref",
          "permit_digest"
        ],
        "properties": {
          "reason_codes": {
            "maxItems": 0
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "verdict": {
            "const": "PROHIBITED"
          }
        }
      },
      "then": {
        "required": [
          "reason_codes"
        ],
        "properties": {
          "reason_codes": {
            "minItems": 1
          }
        },
        "not": {
          "anyOf": [
            {
              "required": [
                "permit_ref"
              ]
            },
            {
              "required": [
                "permit_digest"
              ]
            }
          ]
        }
      }
    }
  ]
}
