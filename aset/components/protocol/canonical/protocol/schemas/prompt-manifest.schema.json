{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:aset:schema:aset.prompt-manifest:1.5-rc8",
  "title": "Prompt Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "document_type",
    "schema_version",
    "document_id",
    "tenant_id",
    "issued_at",
    "issuer",
    "integrity",
    "source_context",
    "purpose",
    "projection_profile",
    "compiler",
    "model_profile",
    "token_budget",
    "selection_policy",
    "sections",
    "canonical_messages",
    "compiler_input_digest",
    "canonical_messages_digest"
  ],
  "properties": {
    "document_type": {
      "const": "aset.prompt-manifest"
    },
    "schema_version": {
      "const": "1.5-rc8"
    },
    "document_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,127}$"
    },
    "tenant_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,127}$"
    },
    "issued_at": {
      "type": "string",
      "format": "date-time"
    },
    "issuer": {
      "const": "aset-prompt-compiler"
    },
    "integrity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "canonicalization",
        "digest_algorithm",
        "document_digest",
        "signature_profile",
        "key_id",
        "signature"
      ],
      "properties": {
        "canonicalization": {
          "const": "ASET-JCS-1"
        },
        "digest_algorithm": {
          "const": "SHA-256"
        },
        "document_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "signature_profile": {
          "const": "Ed25519-SHA256-v1"
        },
        "key_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,127}$"
        },
        "signature": {
          "type": "string",
          "pattern": "^ed25519:[A-Za-z0-9_-]{86}$"
        }
      }
    },
    "source_context": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "composite_root",
        "dependency_component_digests"
      ],
      "properties": {
        "composite_root": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "dependency_component_digests": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          }
        }
      }
    },
    "purpose": {
      "enum": [
        "PLAN_EXECUTION",
        "EXECUTE_TRANSITION",
        "VERIFY_RESULT",
        "HUMAN_REVIEW",
        "MEMORY_CONSOLIDATION"
      ]
    },
    "projection_profile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "version",
        "digest"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,127}$"
        },
        "version": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,127}$"
        },
        "digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      }
    },
    "compiler": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "version",
        "artifact_digest"
      ],
      "properties": {
        "id": {
          "const": "aset-prompt-compiler"
        },
        "version": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,127}$"
        },
        "artifact_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      }
    },
    "model_profile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profile_id",
        "provider",
        "model_id",
        "tokenizer_id",
        "context_window"
      ],
      "properties": {
        "profile_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,127}$"
        },
        "provider": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,127}$"
        },
        "model_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,127}$"
        },
        "tokenizer_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,127}$"
        },
        "context_window": {
          "type": "integer",
          "minimum": 256,
          "maximum": 9007199254740991
        }
      }
    },
    "token_budget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_input_tokens",
        "reserved_output_tokens",
        "actual_input_tokens"
      ],
      "properties": {
        "max_input_tokens": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "reserved_output_tokens": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "actual_input_tokens": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      }
    },
    "selection_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ordering",
        "conflict_resolution",
        "unknown_handling",
        "data_instruction_separation"
      ],
      "properties": {
        "ordering": {
          "const": "role,priority,claim_id"
        },
        "conflict_resolution": {
          "const": "highest_verified_then_latest_gate"
        },
        "unknown_handling": {
          "const": "preserve_explicitly"
        },
        "data_instruction_separation": {
          "const": "typed_sections_only"
        }
      }
    },
    "sections": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "ordinal",
          "role",
          "claim_refs",
          "content_digest",
          "token_count"
        ],
        "properties": {
          "ordinal": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "role": {
            "enum": [
              "SYSTEM_CONSTRAINTS",
              "VERIFIED_FACTS",
              "ASSUMPTIONS",
              "AUTHORIZED_EXPECTED_CHANGE",
              "OPERATIONAL_BINDING",
              "FORBIDDEN_ACTIONS",
              "ACCEPTANCE_CRITERIA",
              "UNRESOLVED_INFORMATION",
              "TOOLS"
            ]
          },
          "claim_refs": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,127}$"
            }
          },
          "content_digest": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          },
          "token_count": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          }
        }
      }
    },
    "canonical_messages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "role",
          "content"
        ],
        "properties": {
          "role": {
            "enum": [
              "system",
              "user",
              "assistant",
              "tool"
            ]
          },
          "content": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "compiler_input_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "canonical_messages_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  }
}
