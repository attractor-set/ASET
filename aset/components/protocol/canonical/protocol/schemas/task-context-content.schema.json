{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:aset:schema:task-context-content:1.5-rc8",
  "title": "task context content",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "task_ref",
    "transition_graph_ref",
    "status"
  ],
  "properties": {
    "task_ref": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,127}$"
    },
    "transition_graph_ref": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,127}$"
    },
    "status": {
      "enum": [
        "OPEN",
        "ACTIVE",
        "BLOCKED",
        "COMPLETED",
        "REJECTED"
      ]
    }
  }
}
