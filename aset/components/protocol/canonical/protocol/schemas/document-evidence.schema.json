{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aset.local/schemas/1.5-rc11/document-evidence.schema.json",
  "title": "ASET Document Evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "status",
    "audit_tool_version",
    "renderer",
    "container_policy",
    "toolchain",
    "documents",
    "totals"
  ],
  "properties": {
    "version": {
      "const": "1.5-rc11"
    },
    "status": {
      "const": "PASS"
    },
    "audit_tool_version": {
      "const": "ASET-DOC-EVIDENCE-3"
    },
    "renderer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "libreoffice",
        "pymupdf",
        "dpi"
      ],
      "properties": {
        "libreoffice": {
          "type": "string",
          "minLength": 1
        },
        "pymupdf": {
          "type": "string",
          "minLength": 1
        },
        "dpi": {
          "const": 90
        }
      }
    },
    "documents": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "docx_path",
          "pdf_path",
          "docx_sha256",
          "pdf_sha256",
          "pages",
          "page_results",
          "accessibility"
        ],
        "properties": {
          "docx_path": {
            "type": "string",
            "pattern": "^docs/.+\\.docx$"
          },
          "pdf_path": {
            "type": "string",
            "pattern": "^docs/.+\\.pdf$"
          },
          "docx_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "pdf_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "pages": {
            "type": "integer",
            "minimum": 1
          },
          "page_results": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "page",
                "docx_render_sha256",
                "delivered_pdf_sha256",
                "equal"
              ],
              "properties": {
                "page": {
                  "type": "integer",
                  "minimum": 1
                },
                "docx_render_sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                },
                "delivered_pdf_sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                },
                "equal": {
                  "const": true
                }
              }
            }
          },
          "accessibility": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "counts",
              "findings"
            ],
            "properties": {
              "counts": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "high",
                  "medium",
                  "low"
                ],
                "properties": {
                  "high": {
                    "const": 0
                  },
                  "medium": {
                    "const": 0
                  },
                  "low": {
                    "const": 0
                  }
                }
              },
              "findings": {
                "type": "array",
                "maxItems": 0
              }
            }
          }
        }
      }
    },
    "totals": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "documents",
        "pages",
        "changed_pages",
        "accessibility_high",
        "accessibility_medium",
        "accessibility_low"
      ],
      "properties": {
        "documents": {
          "const": 5
        },
        "pages": {
          "type": "integer",
          "minimum": 1
        },
        "changed_pages": {
          "const": 0
        },
        "accessibility_high": {
          "const": 0
        },
        "accessibility_medium": {
          "const": 0
        },
        "accessibility_low": {
          "const": 0
        }
      }
    },
    "container_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "errors"
      ],
      "properties": {
        "status": {
          "const": "PASS"
        },
        "errors": {
          "type": "array",
          "maxItems": 0
        }
      }
    },
    "toolchain": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "errors"
      ],
      "properties": {
        "status": {
          "const": "PASS"
        },
        "errors": {
          "type": "array",
          "maxItems": 0
        }
      }
    }
  }
}
