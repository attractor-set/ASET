{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aset.local/schemas/1.5-rc11/external-trust-anchor.schema.json",
  "title": "ASET External Freeze Trust Anchor",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "anchor_id",
    "version",
    "algorithm",
    "public_key_hex",
    "key_id",
    "trust_domain",
    "purpose"
  ],
  "properties": {
    "anchor_id": {
      "const": "aset.external-freeze-trust-anchor.rc11"
    },
    "version": {
      "const": "1.5-rc11"
    },
    "algorithm": {
      "const": "Ed25519"
    },
    "public_key_hex": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "key_id": {
      "const": "key:aset:freeze-authority:rc11"
    },
    "trust_domain": {
      "const": "ASET_FORMAL_CONCEPTUAL_FREEZE"
    },
    "purpose": {
      "const": "OUT_OF_BAND_TRUST_ROOT"
    }
  }
}
