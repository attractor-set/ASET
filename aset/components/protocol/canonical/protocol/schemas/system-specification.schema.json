{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:aset:schema:system-specification:1.5-rc11",
  "title": "ASET System Specification",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "specification_id",
    "version",
    "status",
    "model_digest",
    "protocol",
    "gate_transition_specs",
    "state_machines",
    "prompt_contract",
    "context_contract",
    "acceptance_matrix",
    "conformance",
    "canonical_digest"
  ],
  "properties": {
    "specification_id": {
      "const": "aset.system-specification"
    },
    "version": {
      "const": "1.5-rc11"
    },
    "status": {
      "const": "NORMATIVE_CONCEPTUAL_FREEZE_CANDIDATE"
    },
    "model_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "protocol": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "default_deny",
        "format_validation",
        "unknown_properties",
        "authority_issuer",
        "linearization",
        "external_effect_boundary",
        "artifact_digest_projection",
        "signature_input",
        "numeric_domain",
        "raw_json_member_rule",
        "object_key_order",
        "requirements_source_of_truth",
        "conformance_report_trust"
      ],
      "properties": {
        "default_deny": {
          "const": true
        },
        "format_validation": {
          "const": true
        },
        "unknown_properties": {
          "const": "REJECT"
        },
        "authority_issuer": {
          "const": "ASET Core"
        },
        "linearization": {
          "type": "string"
        },
        "external_effect_boundary": {
          "type": "string"
        },
        "artifact_digest_projection": {
          "type": "string",
          "minLength": 20
        },
        "signature_input": {
          "type": "string",
          "minLength": 20
        },
        "numeric_domain": {
          "type": "string",
          "minLength": 20
        },
        "canonicalization_key_collision": {
          "const": "REJECT_NFC_EQUIVALENT_OBJECT_KEYS_BEFORE_HASHING"
        },
        "permit_time_rule": {
          "type": "string",
          "minLength": 20
        },
        "permit_max_lifetime_seconds": {
          "const": 60
        },
        "positive_fixture_graph": {
          "type": "string",
          "minLength": 20
        },
        "raw_json_member_rule": {
          "const": "REJECT_DUPLICATE_MEMBER_NAMES_BEFORE_PARSE"
        },
        "object_key_order": {
          "const": "NFC-normalize, reject collisions, then sort by ascending unsigned UTF-8 bytes."
        },
        "requirements_source_of_truth": {
          "const": "requirements/requirements_register.csv; JSON is generated and exact-parity checked."
        },
        "conformance_report_trust": {
          "const": "UNTRUSTED_CACHED_OUTPUT; validate_package must rerun the suite and verify the exact result-ID set and input digest."
        }
      }
    },
    "gate_transition_specs": {
      "type": "array",
      "minItems": 11,
      "maxItems": 11,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "gate_id",
          "submission_schema",
          "permit_schema",
          "patch_schema",
          "reads",
          "preconditions",
          "reducer",
          "postconditions",
          "failure_codes",
          "external_effect"
        ],
        "properties": {
          "gate_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,127}$"
          },
          "submission_schema": {
            "type": "string"
          },
          "permit_schema": {
            "type": "string"
          },
          "patch_schema": {
            "type": "string"
          },
          "reads": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "preconditions": {
            "type": "array",
            "minItems": 5,
            "items": {
              "type": "string"
            }
          },
          "reducer": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "version",
              "determinism",
              "forbidden_inputs"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,127}$"
              },
              "version": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,127}$"
              },
              "determinism": {
                "type": "string",
                "minLength": 20
              },
              "forbidden_inputs": {
                "type": "array",
                "minItems": 3,
                "items": {
                  "type": "string"
                }
              }
            }
          },
          "postconditions": {
            "type": "array",
            "minItems": 5,
            "items": {
              "type": "string"
            }
          },
          "failure_codes": {
            "type": "array",
            "minItems": 5,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[A-Z][A-Z0-9_]+$"
            }
          },
          "external_effect": {
            "type": "boolean"
          }
        }
      }
    },
    "state_machines": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "permit",
        "expected_change",
        "crossing"
      ],
      "properties": {
        "permit": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "states",
            "initial",
            "terminal",
            "transitions"
          ],
          "properties": {
            "states": {
              "type": "array",
              "minItems": 2,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,127}$"
              }
            },
            "initial": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,127}$"
            },
            "terminal": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,127}$"
              }
            },
            "transitions": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "from",
                  "event",
                  "to"
                ],
                "properties": {
                  "from": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,127}$"
                  },
                  "event": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,127}$"
                  },
                  "to": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,127}$"
                  },
                  "guard": {
                    "type": "string",
                    "minLength": 3
                  }
                }
              }
            }
          }
        },
        "expected_change": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "states",
            "initial",
            "terminal",
            "transitions"
          ],
          "properties": {
            "states": {
              "type": "array",
              "minItems": 2,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,127}$"
              }
            },
            "initial": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,127}$"
            },
            "terminal": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,127}$"
              }
            },
            "transitions": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "from",
                  "event",
                  "to"
                ],
                "properties": {
                  "from": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,127}$"
                  },
                  "event": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,127}$"
                  },
                  "to": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,127}$"
                  },
                  "guard": {
                    "type": "string",
                    "minLength": 3
                  }
                }
              }
            }
          }
        },
        "crossing": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "states",
            "initial",
            "terminal",
            "transitions"
          ],
          "properties": {
            "states": {
              "type": "array",
              "minItems": 2,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,127}$"
              }
            },
            "initial": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,127}$"
            },
            "terminal": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,127}$"
              }
            },
            "transitions": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "from",
                  "event",
                  "to"
                ],
                "properties": {
                  "from": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,127}$"
                  },
                  "event": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,127}$"
                  },
                  "to": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,127}$"
                  },
                  "guard": {
                    "type": "string",
                    "minLength": 3
                  }
                }
              }
            }
          }
        }
      }
    },
    "prompt_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "owner",
        "deterministic_inputs",
        "sections",
        "outputs",
        "forbidden",
        "compiler_input_projection",
        "budget_invariants",
        "gateway_output"
      ],
      "properties": {
        "owner": {
          "const": "SUB-PROMPT"
        },
        "deterministic_inputs": {
          "type": "array",
          "minItems": 8,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,127}$"
          }
        },
        "sections": {
          "type": "array",
          "minItems": 9,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,127}$"
          }
        },
        "outputs": {
          "type": "array",
          "minItems": 3,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,127}$"
          }
        },
        "forbidden": {
          "type": "array",
          "minItems": 5,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 3
          }
        },
        "compiler_input_projection": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "fields",
            "encoding",
            "digest"
          ],
          "properties": {
            "fields": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 2
              }
            },
            "encoding": {
              "type": "string",
              "minLength": 20
            },
            "digest": {
              "const": "SHA-256"
            }
          }
        },
        "budget_invariants": {
          "type": "array",
          "minItems": 3,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 10
          }
        },
        "gateway_output": {
          "type": "string",
          "minLength": 20
        }
      }
    },
    "context_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profile",
        "leaf_fields",
        "sort_order",
        "tree",
        "uniqueness",
        "owner_mapping",
        "leaf_encoding",
        "leaf_domain_separator",
        "node_domain_separator"
      ],
      "properties": {
        "profile": {
          "const": "ASET-MERKLE-1"
        },
        "leaf_fields": {
          "type": "array",
          "minItems": 6,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,127}$"
          }
        },
        "sort_order": {
          "const": "component_type,component_id,version,digest,owner_id,owner_key_id"
        },
        "tree": {
          "const": "leaf=SHA-256(0x00 || canonical_leaf_bytes); node=SHA-256(0x01 || left32 || right32); duplicate-last at odd level"
        },
        "uniqueness": {
          "type": "array",
          "minItems": 2,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 3
          }
        },
        "owner_mapping": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "memory",
            "master",
            "task",
            "execution",
            "acceptance",
            "authority"
          ],
          "properties": {
            "memory": {
              "const": "aset-memory"
            },
            "master": {
              "const": "aset-master"
            },
            "task": {
              "const": "aset-monade"
            },
            "execution": {
              "const": "aset-monade-execution"
            },
            "acceptance": {
              "const": "aset-monade-acceptance"
            },
            "authority": {
              "const": "aset-core"
            }
          }
        },
        "leaf_encoding": {
          "const": "ASET-JCS-1 canonical JSON object over exactly leaf_fields"
        },
        "leaf_domain_separator": {
          "const": "00"
        },
        "node_domain_separator": {
          "const": "01"
        }
      }
    },
    "acceptance_matrix": {
      "const": [
        {
          "decision": "ACCEPTED",
          "operational_status": "VERIFIED_SUCCESS",
          "normative_status": "COMPLIANT",
          "evidence": "required",
          "unresolved_claims": "forbidden"
        },
        {
          "decision": "PARTIALLY_ACCEPTED",
          "operational_status": "PARTIAL_EFFECT",
          "normative_status": "COMPLIANT",
          "evidence": "required",
          "unresolved_claims": "required"
        },
        {
          "decision": "REJECTED",
          "operational_status": "VERIFIED_FAILURE",
          "normative_status": "COMPLIANT",
          "evidence": "required",
          "unresolved_claims": "optional"
        },
        {
          "decision": "REJECTED",
          "operational_status": "VERIFIED_FAILURE",
          "normative_status": "NON_COMPLIANT",
          "evidence": "required",
          "unresolved_claims": "optional"
        },
        {
          "decision": "REJECTED",
          "operational_status": "NO_EFFECT",
          "normative_status": "COMPLIANT",
          "evidence": "required",
          "unresolved_claims": "optional"
        },
        {
          "decision": "REJECTED",
          "operational_status": "NO_EFFECT",
          "normative_status": "NON_COMPLIANT",
          "evidence": "required",
          "unresolved_claims": "optional"
        },
        {
          "decision": "REJECTED",
          "operational_status": "VERIFIED_SUCCESS",
          "normative_status": "NON_COMPLIANT",
          "evidence": "required",
          "unresolved_claims": "optional"
        },
        {
          "decision": "REJECTED",
          "operational_status": "PARTIAL_EFFECT",
          "normative_status": "NON_COMPLIANT",
          "evidence": "required",
          "unresolved_claims": "required"
        },
        {
          "decision": "EVIDENCE_INSUFFICIENT",
          "operational_status": "EFFECT_UNKNOWN",
          "normative_status": "UNDETERMINED",
          "evidence": "optional",
          "unresolved_claims": "required"
        },
        {
          "decision": "MANUAL_REVIEW_REQUIRED",
          "operational_status": "EFFECT_UNKNOWN",
          "normative_status": "UNDETERMINED",
          "evidence": "optional",
          "unresolved_claims": "required"
        },
        {
          "decision": "MANUAL_REVIEW_REQUIRED",
          "operational_status": "PARTIAL_EFFECT",
          "normative_status": "UNDETERMINED",
          "evidence": "optional",
          "unresolved_claims": "required"
        }
      ]
    },
    "conformance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mandatory_gate_ids",
        "mandatory_invariants",
        "mandatory_schemas",
        "positive_vector_index",
        "negative_vector_index",
        "crypto_vectors",
        "mutation_suite",
        "verification_claims"
      ],
      "properties": {
        "mandatory_gate_ids": {
          "type": "array",
          "minItems": 11,
          "maxItems": 11,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,127}$"
          }
        },
        "mandatory_invariants": {
          "type": "array",
          "minItems": 25,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,127}$"
          }
        },
        "mandatory_schemas": {
          "type": "array",
          "minItems": 48,
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "positive_vector_index": {
          "type": "string"
        },
        "negative_vector_index": {
          "type": "string"
        },
        "crypto_vectors": {
          "type": "string"
        },
        "mutation_suite": {
          "type": "string"
        },
        "verification_claims": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "registered_requirements",
            "implementation_cases",
            "oracle_index",
            "structural_traceability_oracles",
            "semantic_fitcriterion_conformance"
          ],
          "properties": {
            "registered_requirements": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            },
            "implementation_cases": {
              "const": "NOT_EXECUTED_PRE_IMPLEMENTATION"
            },
            "oracle_index": {
              "const": "conformance/requirement_oracles.json"
            },
            "structural_traceability_oracles": {
              "const": 177
            },
            "semantic_fitcriterion_conformance": {
              "const": "NOT_CLAIMED_BY_STRUCTURAL_ORACLES"
            }
          }
        }
      }
    },
    "canonical_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  }
}
