{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:aset:schema:aset.signed-context-component:1.5-rc8",
  "title": "Signed Context Component",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "document_type",
    "schema_version",
    "document_id",
    "tenant_id",
    "issued_at",
    "issuer",
    "integrity",
    "component_type",
    "component_id",
    "version",
    "parent_digest",
    "owner_id",
    "owner_key_id",
    "content_digest",
    "epistemic_status",
    "content",
    "content_schema_id",
    "content_schema_digest"
  ],
  "properties": {
    "document_type": {
      "const": "aset.signed-context-component"
    },
    "schema_version": {
      "const": "1.5-rc8"
    },
    "document_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,127}$"
    },
    "tenant_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,127}$"
    },
    "issued_at": {
      "type": "string",
      "format": "date-time"
    },
    "issuer": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,127}$"
    },
    "integrity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "canonicalization",
        "digest_algorithm",
        "document_digest",
        "signature_profile",
        "key_id",
        "signature"
      ],
      "properties": {
        "canonicalization": {
          "const": "ASET-JCS-1"
        },
        "digest_algorithm": {
          "const": "SHA-256"
        },
        "document_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "signature_profile": {
          "const": "Ed25519-SHA256-v1"
        },
        "key_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,127}$"
        },
        "signature": {
          "type": "string",
          "pattern": "^ed25519:[A-Za-z0-9_-]{86}$"
        }
      }
    },
    "component_type": {
      "enum": [
        "memory",
        "master",
        "task",
        "execution",
        "acceptance",
        "authority"
      ]
    },
    "component_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,127}$"
    },
    "version": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "parent_digest": {
      "oneOf": [
        {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "owner_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,127}$"
    },
    "owner_key_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,127}$"
    },
    "content_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "epistemic_status": {
      "enum": [
        "VERIFIED",
        "ASSERTED",
        "ASSUMED",
        "EXPECTED",
        "OBSERVED",
        "UNKNOWN"
      ]
    },
    "content": {
      "type": "object"
    },
    "content_schema_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,127}$"
    },
    "content_schema_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "component_type": {
            "const": "memory"
          }
        },
        "required": [
          "component_type"
        ]
      },
      "then": {
        "properties": {
          "owner_id": {
            "const": "aset-memory"
          },
          "issuer": {
            "const": "aset-memory"
          },
          "content_schema_id": {
            "const": "urn:aset:schema:memory-context-content:1.5-rc8"
          },
          "content": {
            "$ref": "urn:aset:schema:memory-context-content:1.5-rc8"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "component_type": {
            "const": "master"
          }
        },
        "required": [
          "component_type"
        ]
      },
      "then": {
        "properties": {
          "owner_id": {
            "const": "aset-master"
          },
          "issuer": {
            "const": "aset-master"
          },
          "content_schema_id": {
            "const": "urn:aset:schema:master-context-content:1.5-rc8"
          },
          "content": {
            "$ref": "urn:aset:schema:master-context-content:1.5-rc8"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "component_type": {
            "const": "task"
          }
        },
        "required": [
          "component_type"
        ]
      },
      "then": {
        "properties": {
          "owner_id": {
            "const": "aset-monade"
          },
          "issuer": {
            "const": "aset-monade"
          },
          "content_schema_id": {
            "const": "urn:aset:schema:task-context-content:1.5-rc8"
          },
          "content": {
            "$ref": "urn:aset:schema:task-context-content:1.5-rc8"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "component_type": {
            "const": "execution"
          }
        },
        "required": [
          "component_type"
        ]
      },
      "then": {
        "properties": {
          "owner_id": {
            "const": "aset-monade-execution"
          },
          "issuer": {
            "const": "aset-monade-execution"
          },
          "content_schema_id": {
            "const": "urn:aset:schema:execution-context-content:1.5-rc8"
          },
          "content": {
            "$ref": "urn:aset:schema:execution-context-content:1.5-rc8"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "component_type": {
            "const": "acceptance"
          }
        },
        "required": [
          "component_type"
        ]
      },
      "then": {
        "properties": {
          "owner_id": {
            "const": "aset-monade-acceptance"
          },
          "issuer": {
            "const": "aset-monade-acceptance"
          },
          "content_schema_id": {
            "const": "urn:aset:schema:acceptance-context-content:1.5-rc8"
          },
          "content": {
            "$ref": "urn:aset:schema:acceptance-context-content:1.5-rc8"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "component_type": {
            "const": "authority"
          }
        },
        "required": [
          "component_type"
        ]
      },
      "then": {
        "properties": {
          "owner_id": {
            "const": "aset-core"
          },
          "issuer": {
            "const": "aset-core"
          },
          "content_schema_id": {
            "const": "urn:aset:schema:authority-context-content:1.5-rc8"
          },
          "content": {
            "$ref": "urn:aset:schema:authority-context-content:1.5-rc8"
          }
        }
      }
    }
  ]
}
