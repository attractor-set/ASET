{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:aset:schema:aset.provider-request-manifest:1.5-rc8",
  "title": "Provider Request Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "document_type",
    "schema_version",
    "document_id",
    "tenant_id",
    "issued_at",
    "issuer",
    "integrity",
    "source_prompt_manifest_ref",
    "source_prompt_manifest_digest",
    "adapter",
    "provider",
    "model_id",
    "rendered_request_media_type",
    "rendered_request",
    "rendered_request_digest"
  ],
  "properties": {
    "document_type": {
      "const": "aset.provider-request-manifest"
    },
    "schema_version": {
      "const": "1.5-rc8"
    },
    "document_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,127}$"
    },
    "tenant_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,127}$"
    },
    "issued_at": {
      "type": "string",
      "format": "date-time"
    },
    "issuer": {
      "const": "aset-model-gateway"
    },
    "integrity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "canonicalization",
        "digest_algorithm",
        "document_digest",
        "signature_profile",
        "key_id",
        "signature"
      ],
      "properties": {
        "canonicalization": {
          "const": "ASET-JCS-1"
        },
        "digest_algorithm": {
          "const": "SHA-256"
        },
        "document_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "signature_profile": {
          "const": "Ed25519-SHA256-v1"
        },
        "key_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,127}$"
        },
        "signature": {
          "type": "string",
          "pattern": "^ed25519:[A-Za-z0-9_-]{86}$"
        }
      }
    },
    "source_prompt_manifest_ref": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,127}$"
    },
    "source_prompt_manifest_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "adapter": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "version",
        "artifact_digest"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,127}$"
        },
        "version": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,127}$"
        },
        "artifact_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      }
    },
    "provider": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,127}$"
    },
    "model_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,127}$"
    },
    "rendered_request_media_type": {
      "const": "application/json; charset=utf-8"
    },
    "rendered_request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "model",
        "messages",
        "max_tokens",
        "stream"
      ],
      "properties": {
        "model": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,127}$"
        },
        "messages": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "role",
              "content"
            ],
            "properties": {
              "role": {
                "enum": [
                  "system",
                  "user",
                  "assistant",
                  "tool"
                ]
              },
              "content": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "max_tokens": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "stream": {
          "type": "boolean"
        }
      }
    },
    "rendered_request_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  }
}
