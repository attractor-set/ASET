{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:aset:schema:system-model:1.5-rc11",
  "title": "ASET System Model",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "model_id",
    "version",
    "status",
    "date",
    "modules",
    "subsystems",
    "context_components",
    "artifacts",
    "gate_types",
    "invariants",
    "state_machines",
    "prompt_compilation",
    "context_composition",
    "crypto_profile",
    "workflow",
    "deprecated_terms",
    "canonical_digest"
  ],
  "properties": {
    "model_id": {
      "const": "aset.system-model"
    },
    "version": {
      "const": "1.5-rc11"
    },
    "status": {
      "const": "NORMATIVE_CONCEPTUAL_FREEZE_CANDIDATE"
    },
    "date": {
      "const": "2026-08-03"
    },
    "modules": {
      "type": "array",
      "minItems": 6,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "purpose",
          "owns",
          "must_not"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,127}$"
          },
          "name": {
            "type": "string",
            "minLength": 3
          },
          "purpose": {
            "type": "string",
            "minLength": 20
          },
          "owns": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 2
            }
          },
          "must_not": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 2
            }
          }
        }
      }
    },
    "subsystems": {
      "type": "array",
      "minItems": 5,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "parent",
          "name",
          "purpose",
          "owns",
          "must_not"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,127}$"
          },
          "parent": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,127}$"
          },
          "name": {
            "type": "string",
            "minLength": 3
          },
          "purpose": {
            "type": "string",
            "minLength": 20
          },
          "owns": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 2
            }
          },
          "must_not": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 2
            }
          }
        }
      }
    },
    "context_components": {
      "type": "array",
      "minItems": 6,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "owner",
          "type",
          "content"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,127}$"
          },
          "owner": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,127}$"
          },
          "type": {
            "enum": [
              "memory",
              "master",
              "task",
              "execution",
              "acceptance",
              "authority"
            ]
          },
          "content": {
            "type": "string",
            "minLength": 10
          }
        }
      }
    },
    "artifacts": {
      "type": "array",
      "minItems": 39,
      "uniqueItems": true,
      "items": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "name",
              "role",
              "owner",
              "schema"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,127}$"
              },
              "name": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,127}$"
              },
              "role": {
                "allOf": [
                  {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,127}$"
                  },
                  {
                    "not": {
                      "const": "stable-compatibility-alias"
                    }
                  }
                ]
              },
              "owner": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,127}$"
              },
              "schema": {
                "type": "string",
                "minLength": 3
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "name",
              "role",
              "owner",
              "alias_of",
              "schema"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,127}$"
              },
              "name": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,127}$"
              },
              "role": {
                "const": "stable-compatibility-alias"
              },
              "owner": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,127}$"
              },
              "schema": {
                "const": "see alias target"
              },
              "alias_of": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,127}$"
              }
            }
          }
        ]
      }
    },
    "gate_types": {
      "type": "array",
      "minItems": 11,
      "maxItems": 11,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "document",
          "document_schema",
          "permit",
          "permit_schema",
          "patch",
          "patch_schema",
          "producer",
          "external_effect",
          "writes",
          "reducer_id",
          "failure_codes"
        ],
        "properties": {
          "id": {
            "enum": [
              "GATE-CONTEXT-PROJECT",
              "GATE-EXPECT-ADMIT",
              "GATE-EXEC-BIND",
              "GATE-DISPATCH",
              "GATE-OBSERVE",
              "GATE-EVIDENCE",
              "GATE-ACCEPT",
              "GATE-RETRY",
              "GATE-COMPENSATE",
              "GATE-TASK-CLOSE",
              "GATE-MEM-MUTATE"
            ]
          },
          "document": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,127}$"
          },
          "document_schema": {
            "type": "string",
            "pattern": "^[a-z0-9-]+\\.schema\\.json$"
          },
          "permit": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,127}$"
          },
          "permit_schema": {
            "type": "string",
            "pattern": "^[a-z0-9-]+\\.schema\\.json$"
          },
          "patch": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,127}$"
          },
          "patch_schema": {
            "type": "string",
            "pattern": "^[a-z0-9-]+\\.schema\\.json$"
          },
          "producer": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,127}$"
          },
          "external_effect": {
            "type": "boolean"
          },
          "writes": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,127}$"
            }
          },
          "reducer_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,127}$"
          },
          "failure_codes": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[A-Z][A-Z0-9_]+$"
            }
          }
        }
      }
    },
    "invariants": {
      "type": "array",
      "minItems": 25,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "statement"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^INV-[A-Z0-9-]+-[0-9]{3}$"
          },
          "statement": {
            "type": "string",
            "minLength": 20
          }
        }
      }
    },
    "state_machines": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "permit",
        "expected_change",
        "crossing"
      ],
      "properties": {
        "permit": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "states",
            "initial",
            "terminal",
            "transitions"
          ],
          "properties": {
            "states": {
              "type": "array",
              "minItems": 2,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,127}$"
              }
            },
            "initial": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,127}$"
            },
            "terminal": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,127}$"
              }
            },
            "transitions": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "from",
                  "event",
                  "to"
                ],
                "properties": {
                  "from": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,127}$"
                  },
                  "event": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,127}$"
                  },
                  "to": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,127}$"
                  },
                  "guard": {
                    "type": "string",
                    "minLength": 3
                  }
                }
              }
            }
          }
        },
        "expected_change": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "states",
            "initial",
            "terminal",
            "transitions"
          ],
          "properties": {
            "states": {
              "type": "array",
              "minItems": 2,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,127}$"
              }
            },
            "initial": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,127}$"
            },
            "terminal": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,127}$"
              }
            },
            "transitions": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "from",
                  "event",
                  "to"
                ],
                "properties": {
                  "from": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,127}$"
                  },
                  "event": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,127}$"
                  },
                  "to": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,127}$"
                  },
                  "guard": {
                    "type": "string",
                    "minLength": 3
                  }
                }
              }
            }
          }
        },
        "crossing": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "states",
            "initial",
            "terminal",
            "transitions"
          ],
          "properties": {
            "states": {
              "type": "array",
              "minItems": 2,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,127}$"
              }
            },
            "initial": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,127}$"
            },
            "terminal": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,127}$"
              }
            },
            "transitions": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "from",
                  "event",
                  "to"
                ],
                "properties": {
                  "from": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,127}$"
                  },
                  "event": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,127}$"
                  },
                  "to": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,127}$"
                  },
                  "guard": {
                    "type": "string",
                    "minLength": 3
                  }
                }
              }
            }
          }
        }
      }
    },
    "prompt_compilation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "owner",
        "deterministic_inputs",
        "sections",
        "outputs",
        "forbidden",
        "gateway_boundary"
      ],
      "properties": {
        "owner": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,127}$"
        },
        "deterministic_inputs": {
          "type": "array",
          "minItems": 5,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,127}$"
          }
        },
        "sections": {
          "type": "array",
          "minItems": 5,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,127}$"
          }
        },
        "outputs": {
          "type": "array",
          "minItems": 2,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,127}$"
          }
        },
        "forbidden": {
          "type": "array",
          "minItems": 3,
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "gateway_boundary": {
          "type": "string",
          "minLength": 20
        }
      }
    },
    "context_composition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profile",
        "leaf_fields",
        "sort_order",
        "tree",
        "uniqueness",
        "owner_mapping",
        "leaf_encoding",
        "leaf_domain_separator",
        "node_domain_separator"
      ],
      "properties": {
        "profile": {
          "const": "ASET-MERKLE-1"
        },
        "leaf_fields": {
          "type": "array",
          "minItems": 6,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,127}$"
          }
        },
        "sort_order": {
          "const": "component_type,component_id,version,digest,owner_id,owner_key_id"
        },
        "tree": {
          "const": "leaf=SHA-256(0x00 || canonical_leaf_bytes); node=SHA-256(0x01 || left32 || right32); duplicate-last at odd level"
        },
        "uniqueness": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "string"
          }
        },
        "owner_mapping": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "memory",
            "master",
            "task",
            "execution",
            "acceptance",
            "authority"
          ],
          "properties": {
            "memory": {
              "const": "aset-memory"
            },
            "master": {
              "const": "aset-master"
            },
            "task": {
              "const": "aset-monade"
            },
            "execution": {
              "const": "aset-monade-execution"
            },
            "acceptance": {
              "const": "aset-monade-acceptance"
            },
            "authority": {
              "const": "aset-core"
            }
          }
        },
        "leaf_encoding": {
          "const": "ASET-JCS-1 canonical JSON object over exactly leaf_fields"
        },
        "leaf_domain_separator": {
          "const": "00"
        },
        "node_domain_separator": {
          "const": "01"
        }
      }
    },
    "crypto_profile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "canonicalization",
        "normalization",
        "digest",
        "signature",
        "test_vectors",
        "digest_projection",
        "signature_input",
        "artifact_key_registry",
        "positive_artifacts",
        "raw_json_member_rule",
        "object_key_order",
        "key_registry",
        "key_trust_profile",
        "normative_serialization"
      ],
      "properties": {
        "canonicalization": {
          "const": "ASET-JCS-1"
        },
        "normalization": {
          "type": "string"
        },
        "digest": {
          "const": "SHA-256"
        },
        "signature": {
          "const": "Ed25519 over signature_input"
        },
        "test_vectors": {
          "const": "conformance/crypto/crypto-vectors.json"
        },
        "digest_projection": {
          "const": "entire artifact excluding integrity.document_digest and integrity.signature; all other fields retained"
        },
        "signature_input": {
          "const": "UTF-8 document_type + LF + schema_version + LF + issuer + LF + tenant_id + LF + document_digest"
        },
        "artifact_key_registry": {
          "const": "conformance/crypto/artifact-key-registry.json"
        },
        "positive_artifacts": {
          "const": "Every positive artifact example has a valid document digest and Ed25519 signature."
        },
        "unicode_key_collision_rule": {
          "type": "string",
          "minLength": 20
        },
        "canonicalization_numeric_domain": {
          "type": "string",
          "minLength": 20
        },
        "raw_json_member_rule": {
          "const": "Reject duplicate raw member names before semantic parsing or canonicalization."
        },
        "object_key_order": {
          "const": "Ascending unsigned UTF-8 byte sequence of NFC-normalized keys."
        },
        "key_registry": {
          "const": "conformance/crypto/artifact-key-registry.json"
        },
        "key_trust_profile": {
          "type": "string",
          "minLength": 40
        },
        "normative_serialization": {
          "type": "string",
          "minLength": 60
        }
      }
    },
    "workflow": {
      "type": "array",
      "minItems": 8
    },
    "deprecated_terms": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "term",
          "replacement",
          "status",
          "scope"
        ],
        "properties": {
          "term": {
            "type": "string",
            "minLength": 2
          },
          "replacement": {
            "type": "string",
            "minLength": 2
          },
          "status": {
            "const": "DEPRECATED"
          },
          "scope": {
            "const": "historical only"
          }
        }
      }
    },
    "canonical_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  }
}
