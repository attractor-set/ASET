@prefix aset: <https://w3id.org/aset/component/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

aset:Component a rdfs:Class .
aset:Operation a rdfs:Class .
aset:owns a rdf:Property .
aset:mapsToSeed a rdf:Property .

aset:aset_master a aset:Component ;
    rdfs:label "aset.master" ;
    aset:owns aset:AttractorDescriptor, aset:ExpectedChangePatch, aset:LearningObservation, aset:PlanAssessment, aset:PlanProposal, aset:TrajectoryAssessment .

aset:MASTER_PLAN a aset:Operation ;
    rdfs:label "ProposePlan" ;
    aset:mapsToSeed "none" .

aset:MASTER_EXPECT a aset:Operation ;
    rdfs:label "ProposeExpectedChange" ;
    aset:mapsToSeed "none" .

aset:MASTER_ATTRACTOR a aset:Operation ;
    rdfs:label "AssessAttractor" ;
    aset:mapsToSeed "none" .
