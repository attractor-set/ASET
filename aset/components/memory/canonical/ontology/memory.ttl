@prefix aset: <https://w3id.org/aset/component/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

aset:Component a rdfs:Class .
aset:Operation a rdfs:Class .
aset:owns a rdf:Property .
aset:mapsToSeed a rdf:Property .

aset:aset_memory a aset:Component ;
    rdfs:label "aset.memory" ;
    aset:owns aset:ContextProjection, aset:MemoryCandidate, aset:MemoryItem, aset:MemoryReceipt, aset:RawEvent .

aset:MEM_PROJECT a aset:Operation ;
    rdfs:label "ProjectMemory" ;
    aset:mapsToSeed "none" .

aset:MEM_MUTATE a aset:Operation ;
    rdfs:label "MutateMemory" ;
    aset:mapsToSeed "Decision -> Permit -> PermitUseReceipt" .
