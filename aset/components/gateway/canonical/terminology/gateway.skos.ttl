@prefix aset: <https://w3id.org/aset/component/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

aset:aset_model_gatewayScheme a skos:ConceptScheme ;
    skos:prefLabel "aset.model-gateway terminology"@en .

aset:ModelProfile a skos:Concept ;
    skos:inScheme aset:aset_model_gatewayScheme ;
    skos:notation "ModelProfile" ;
    skos:prefLabel "ModelProfile"@ru ;
    skos:prefLabel "ModelProfile"@en ;
    skos:prefLabel "ModelProfile"@pt-BR ;
    skos:definition "Normative concept owned by aset.model-gateway."@en .

aset:ProviderAdapter a skos:Concept ;
    skos:inScheme aset:aset_model_gatewayScheme ;
    skos:notation "ProviderAdapter" ;
    skos:prefLabel "ProviderAdapter"@ru ;
    skos:prefLabel "ProviderAdapter"@en ;
    skos:prefLabel "ProviderAdapter"@pt-BR ;
    skos:definition "Normative concept owned by aset.model-gateway."@en .

aset:RenderedModelRequest a skos:Concept ;
    skos:inScheme aset:aset_model_gatewayScheme ;
    skos:notation "RenderedModelRequest" ;
    skos:prefLabel "RenderedModelRequest"@ru ;
    skos:prefLabel "RenderedModelRequest"@en ;
    skos:prefLabel "RenderedModelRequest"@pt-BR ;
    skos:definition "Normative concept owned by aset.model-gateway."@en .

aset:UsageReceipt a skos:Concept ;
    skos:inScheme aset:aset_model_gatewayScheme ;
    skos:notation "UsageReceipt" ;
    skos:prefLabel "UsageReceipt"@ru ;
    skos:prefLabel "UsageReceipt"@en ;
    skos:prefLabel "UsageReceipt"@pt-BR ;
    skos:definition "Normative concept owned by aset.model-gateway."@en .

aset:GW_RENDER a skos:Concept ;
    skos:inScheme aset:aset_model_gatewayScheme ;
    skos:notation "GW-RENDER" ;
    skos:prefLabel "RenderProviderRequest"@ru ;
    skos:prefLabel "RenderProviderRequest"@en ;
    skos:prefLabel "RenderProviderRequest"@pt-BR ;
    skos:definition "Render exact provider request bytes from a PromptManifest without changing canonical context."@en .
