{
  "model_id": "aset.system-model",
  "version": "1.5-rc11",
  "status": "NORMATIVE_CONCEPTUAL_FREEZE_CANDIDATE",
  "date": "2026-08-03",
  "modules": [
    {
      "id": "MOD-MEM",
      "name": "ASET Memory",
      "purpose": "Долговременная память, provenance, связи, эпистемические статусы и контекстные проекции.",
      "owns": [
        "RawEvent",
        "MemoryCandidate",
        "MemoryItem",
        "ContextProjection",
        "MemoryReceipt"
      ],
      "must_not": [
        "issue Permit",
        "own Task",
        "self-verify claims"
      ]
    },
    {
      "id": "MOD-CORE",
      "name": "ASET Core",
      "purpose": "Единственный эмитент Permit и доверенное ядро атомарного пересечения нормативных гейтов.",
      "owns": [
        "AuthorityGraph",
        "PolicySet",
        "CoreResolution",
        "OneShotPermit",
        "GateKernel",
        "GateCrossingReceipt",
        "NormativeLedger"
      ],
      "must_not": [
        "plan",
        "execute external effect",
        "accept result",
        "rewrite submission"
      ]
    },
    {
      "id": "MOD-MASTER",
      "name": "ASET Master",
      "purpose": "Планирование, критика траекторий и формирование подписанного ExpectedChangePatch.",
      "owns": [
        "PlanProposal",
        "PlanAssessment",
        "ExpectedChangePatch",
        "TrajectoryAssessment",
        "LearningObservation"
      ],
      "must_not": [
        "issue Permit",
        "dispatch effect",
        "accept own work"
      ]
    },
    {
      "id": "MOD-MONADE",
      "name": "ASET Monade",
      "purpose": "Управление Task через независимые компоненты Execution и Acceptance.",
      "owns": [
        "Task",
        "PlanRevision",
        "TransitionGraph",
        "Outcome"
      ],
      "must_not": [
        "issue Permit",
        "replace Core",
        "self-accept execution"
      ]
    },
    {
      "id": "MOD-GW",
      "name": "ASET Model Gateway",
      "purpose": "Provider-neutral model access и provider-specific rendering.",
      "owns": [
        "ModelProfile",
        "ProviderAdapter",
        "RenderedModelRequest",
        "UsageReceipt"
      ],
      "must_not": [
        "own canonical context",
        "execute tool call",
        "change PromptManifest"
      ]
    },
    {
      "id": "MOD-PROTO",
      "name": "ASET Protocol",
      "purpose": "Schemas, canonicalization, signatures, IDs, compatibility и conformance profiles.",
      "owns": [
        "SchemaRegistry",
        "CanonicalEnvelope",
        "SignatureProfile",
        "ErrorEnvelope"
      ],
      "must_not": [
        "contain module business logic",
        "issue Permit",
        "accept work"
      ]
    }
  ],
  "subsystems": [
    {
      "id": "SUB-MON-EXEC",
      "parent": "MOD-MONADE",
      "name": "Monade Execution",
      "purpose": "Plan admission, OperationalBinding, prompt compilation, dispatch, observation, recovery.",
      "owns": [
        "OperationalBinding",
        "ExecutionIntent",
        "OutboxCommand",
        "WorkerEnvelope",
        "ExecutionObservation"
      ],
      "must_not": [
        "create AcceptanceDecision",
        "issue Permit",
        "weaken ExpectedChangePatch"
      ]
    },
    {
      "id": "SUB-MON-ACC",
      "parent": "MOD-MONADE",
      "name": "Monade Acceptance",
      "purpose": "Independent evidence acquisition, verification, acceptance and Task completion.",
      "owns": [
        "AcceptanceContract",
        "EvidenceBundle",
        "VerificationVerdict",
        "AcceptanceDecision",
        "TaskAcceptance"
      ],
      "must_not": [
        "execute primary effect",
        "issue Permit",
        "accept self-report by default"
      ]
    },
    {
      "id": "SUB-PROMPT",
      "parent": "SUB-MON-EXEC",
      "name": "Prompt Compiler",
      "purpose": "Deterministic CompositeContext to PromptManifest compilation.",
      "owns": [
        "ProjectionProfile",
        "PromptManifest",
        "TokenBudgetPlan"
      ],
      "must_not": [
        "call LLM",
        "promote epistemic status",
        "invent facts"
      ]
    },
    {
      "id": "SUB-WORKER",
      "parent": "SUB-MON-EXEC",
      "name": "Worker Runtime",
      "purpose": "Execute one bounded WorkerEnvelope.",
      "owns": [
        "EphemeralExecutionState",
        "ToolInvocation",
        "WorkerObservation"
      ],
      "must_not": [
        "change plan, expectation or Permit",
        "accept own work"
      ]
    },
    {
      "id": "SUB-VERIFIER",
      "parent": "SUB-MON-ACC",
      "name": "Verifier Registry",
      "purpose": "Versioned deterministic, external, human and model-assisted verifier profiles.",
      "owns": [
        "VerifierAdapter",
        "VerificationReceipt"
      ],
      "must_not": [
        "issue Permit",
        "execute primary effect"
      ]
    }
  ],
  "context_components": [
    {
      "id": "CTX-MEM",
      "owner": "MOD-MEM",
      "type": "memory",
      "content": "facts, provenance, epistemic status, scoped memory projection"
    },
    {
      "id": "CTX-MASTER",
      "owner": "MOD-MASTER",
      "type": "master",
      "content": "goal, plans, assessments, ExpectedChangePatch"
    },
    {
      "id": "CTX-TASK",
      "owner": "MOD-MONADE",
      "type": "task",
      "content": "Task, PlanRevision, TransitionGraph"
    },
    {
      "id": "CTX-EXEC",
      "owner": "SUB-MON-EXEC",
      "type": "execution",
      "content": "OperationalBinding, intent, outbox, observations"
    },
    {
      "id": "CTX-ACC",
      "owner": "SUB-MON-ACC",
      "type": "acceptance",
      "content": "contract, evidence, verdict, outcome"
    },
    {
      "id": "CTX-AUTH",
      "owner": "MOD-CORE",
      "type": "authority",
      "content": "authority epoch, resolution, Permit, crossing receipt"
    }
  ],
