{
  "specification_id": "aset.system-specification",
  "version": "1.5-rc11",
  "status": "NORMATIVE_CONCEPTUAL_FREEZE_CANDIDATE",
  "model_digest": "sha256:cd569fafe4e241cda24527384776dc0637379529a36ffe2870cb318f3c830b94",
  "protocol": {
    "default_deny": true,
    "format_validation": true,
    "unknown_properties": "REJECT",
    "authority_issuer": "ASET Core",
    "linearization": "atomic patch set + new root + HEAD CAS + Permit consumption + receipt",
    "external_effect_boundary": "outbox after gate; effect not asserted by GateCrossingReceipt",
    "artifact_digest_projection": "Entire artifact excluding integrity.document_digest and integrity.signature; all other fields retained.",
    "signature_input": "UTF-8 document_type + LF + schema_version + LF + issuer + LF + tenant_id + LF + document_digest.",
    "numeric_domain": "Signed normative JSON allows only integers in [-9007199254740991,9007199254740991]; larger integers use decimal strings under a dedicated schema.",
    "canonicalization_key_collision": "REJECT_NFC_EQUIVALENT_OBJECT_KEYS_BEFORE_HASHING",
    "permit_time_rule": "consume_before must be strictly later than issued_at and no more than 60 seconds later.",
    "permit_max_lifetime_seconds": 60,
    "positive_fixture_graph": "Eleven complete digest-linked signed authority chains (Submission→Resolution→Permit→Patch), plus the representative PatchSet→Receipt→Context and Prompt→Provider continuations.",
    "raw_json_member_rule": "REJECT_DUPLICATE_MEMBER_NAMES_BEFORE_PARSE",
    "object_key_order": "NFC-normalize, reject collisions, then sort by ascending unsigned UTF-8 bytes.",
    "requirements_source_of_truth": "requirements/requirements_register.csv; JSON is generated and exact-parity checked.",
    "conformance_report_trust": "UNTRUSTED_CACHED_OUTPUT; validate_package must rerun the suite and verify the exact result-ID set and input digest."
  },
