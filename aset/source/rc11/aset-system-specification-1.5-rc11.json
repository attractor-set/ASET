  "state_machines": {
    "permit": {
      "states": [
        "NONEXISTENT",
        "ISSUED",
        "CONSUMED",
        "EXPIRED",
        "REVOKED"
      ],
      "initial": "NONEXISTENT",
      "terminal": [
        "CONSUMED",
        "EXPIRED",
        "REVOKED"
      ],
      "transitions": [
        {
          "from": "NONEXISTENT",
          "event": "ISSUE_AFTER_PERMITTED",
          "to": "ISSUED",
          "guard": "resolution=PERMITTED"
        },
        {
          "from": "ISSUED",
          "event": "CROSS",
          "to": "CONSUMED",
          "guard": "exact_context_and_gate_and_before_deadline"
        },
        {
          "from": "ISSUED",
          "event": "DEADLINE",
          "to": "EXPIRED",
          "guard": "now>=consume_before"
        },
        {
          "from": "ISSUED",
          "event": "REVOKE",
          "to": "REVOKED",
          "guard": "before_linearization"
        }
      ]
    },
    "expected_change": {
      "states": [
        "PROPOSED",
        "AUTHORIZED_EXPECTED",
        "EXECUTION_BOUND",
        "EXECUTION_ATTEMPTED",
        "OBSERVED",
        "VERIFIED",
        "REJECTED",
        "PARTIAL",
        "UNKNOWN",
        "TASK_ACCEPTED",
        "TASK_REJECTED"
      ],
      "initial": "PROPOSED",
      "terminal": [
        "TASK_ACCEPTED",
        "TASK_REJECTED"
      ],
      "transitions": [
        {
          "from": "PROPOSED",
          "event": "EXPECTATION_GATE",
          "to": "AUTHORIZED_EXPECTED"
        },
        {
          "from": "AUTHORIZED_EXPECTED",
          "event": "BINDING_GATE",
          "to": "EXECUTION_BOUND"
        },
        {
          "from": "EXECUTION_BOUND",
          "event": "DISPATCH_GATE",
          "to": "EXECUTION_ATTEMPTED"
        },
        {
          "from": "EXECUTION_ATTEMPTED",
          "event": "OBSERVATION_GATE",
          "to": "OBSERVED"
        },
        {
          "from": "OBSERVED",
          "event": "ACCEPT_VERIFIED",
          "to": "VERIFIED"
        },
        {
          "from": "OBSERVED",
          "event": "ACCEPT_REJECTED",
          "to": "REJECTED"
        },
        {
          "from": "OBSERVED",
          "event": "ACCEPT_PARTIAL",
          "to": "PARTIAL"
        },
        {
          "from": "OBSERVED",
          "event": "ACCEPT_UNKNOWN",
          "to": "UNKNOWN"
        },
        {
          "from": "VERIFIED",
          "event": "TASK_CLOSE_SUCCESS",
          "to": "TASK_ACCEPTED"
        },
        {
          "from": "REJECTED",
          "event": "TASK_CLOSE_FAILURE",
          "to": "TASK_REJECTED"
        },
        {
          "from": "PARTIAL",
          "event": "TASK_CLOSE_FAILURE",
          "to": "TASK_REJECTED"
        },
        {
          "from": "UNKNOWN",
          "event": "TASK_CLOSE_FAILURE",
          "to": "TASK_REJECTED"
        }
      ]
    },
    "crossing": {
      "states": [
        "ABSENT",
        "LINEARIZED"
      ],
      "initial": "ABSENT",
      "terminal": [
        "LINEARIZED"
      ],
      "transitions": [
        {
          "from": "ABSENT",
          "event": "ATOMIC_APPLY",
          "to": "LINEARIZED",
          "guard": "CAS_heads_and_valid_permit"
        },
        {
          "from": "LINEARIZED",
          "event": "REPLAY_SAME_CROSSING_ID",
          "to": "LINEARIZED",
          "guard": "return_identical_receipt"
        }
      ]
    }
  },
  "prompt_contract": {
    "owner": "SUB-PROMPT",
    "deterministic_inputs": [
      "source_context",
      "purpose",
      "projection_profile",
      "compiler",
      "model_profile",
      "token_budget_plan",
      "selection_policy",
      "section_claim_refs_and_content_digests"
    ],
    "sections": [
      "SYSTEM_CONSTRAINTS",
      "VERIFIED_FACTS",
      "ASSUMPTIONS",
      "AUTHORIZED_EXPECTED_CHANGE",
      "OPERATIONAL_BINDING",
      "FORBIDDEN_ACTIONS",
      "ACCEPTANCE_CRITERIA",
      "UNRESOLVED_INFORMATION",
      "TOOLS"
    ],
    "outputs": [
      "PromptManifest",
      "canonical_messages",
      "canonical_messages_digest",
      "ProviderRequestManifest",
      "rendered_request_digest"
    ],
    "forbidden": [
      "network reads during compile",
      "clock dependence not materialized as input",
      "randomness",
      "LLM calls",
      "untyped inline instructions"
    ],
    "compiler_input_projection": {
      "fields": [
        "source_context",
        "purpose",
        "projection_profile",
        "compiler",
        "model_profile",
        "token_budget.max_input_tokens",
        "token_budget.reserved_output_tokens",
        "selection_policy",
        "sections"
      ],
      "encoding": "ASET-JCS-1 over an object retaining exactly the listed fields and the complete section objects in ordinal order",
      "digest": "SHA-256"
    },
    "budget_invariants": [
      "actual_input_tokens equals sum(sections.token_count)",
      "actual_input_tokens <= max_input_tokens",
      "max_input_tokens + reserved_output_tokens <= model_profile.context_window"
    ],
    "gateway_output": "ProviderRequestManifest binds source PromptManifest digest, adapter artifact, provider/model, exact canonical JSON request and rendered_request_digest."
  },
  "context_contract": {
    "profile": "ASET-MERKLE-1",
    "leaf_fields": [
      "component_type",
      "component_id",
      "version",
      "digest",
      "owner_id",
      "owner_key_id"
    ],
    "sort_order": "component_type,component_id,version,digest,owner_id,owner_key_id",
    "tree": "leaf=SHA-256(0x00 || canonical_leaf_bytes); node=SHA-256(0x01 || left32 || right32); duplicate-last at odd level",
    "uniqueness": [
      "component_id unique within manifest",
      "component tuple unique"
    ],
    "owner_mapping": {
      "memory": "aset-memory",
      "master": "aset-master",
      "task": "aset-monade",
      "execution": "aset-monade-execution",
      "acceptance": "aset-monade-acceptance",
      "authority": "aset-core"
    },
