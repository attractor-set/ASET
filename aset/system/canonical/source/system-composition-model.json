    "composition": {
      "leaf_domain_separator": "00",
      "leaf_encoding": "ASET-JCS-1 canonical JSON object over exactly leaf_fields",
      "leaf_fields": [
        "component_type",
        "component_id",
        "version",
        "digest",
        "owner_id",
        "owner_key_id"
      ],
      "node_domain_separator": "01",
      "owner_mapping": {
        "acceptance": "aset-monade-acceptance",
        "authority": "aset-core",
        "execution": "aset-monade-execution",
        "master": "aset-master",
        "memory": "aset-memory",
        "task": "aset-monade"
      },
      "profile": "ASET-MERKLE-1",
      "sort_order": "component_type,component_id,version,digest,owner_id,owner_key_id",
      "tree": "leaf=SHA-256(0x00 || canonical_leaf_bytes); node=SHA-256(0x01 || left32 || right32); duplicate-last at odd level",
      "uniqueness": [
        "component_id unique within manifest",
        "component tuple unique"
      ]
    },
    "rule": "Context is a namespace; subject and task contexts exist inside their federation/trust-space namespace."
  },
