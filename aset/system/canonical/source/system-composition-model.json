  "invariant_assignments": [
    {
      "id": "INV-ACC-001",
      "statement": "ACCEPTED requires VERIFIED_SUCCESS, COMPLIANT, evidence and no unresolved claims.",
      "target": "monade"
    },
    {
      "id": "INV-ACC-002",
      "statement": "EFFECT_UNKNOWN can only produce EVIDENCE_INSUFFICIENT or MANUAL_REVIEW_REQUIRED with UNDETERMINED normative status.",
      "target": "monade"
    },
    {
      "id": "INV-ANCHOR-SCHEMA-001",
      "statement": "The external trust anchor is validated against a closed schema, including version, trust domain and purpose, before its public key is used.",
      "target": "system"
    },
    {
      "id": "INV-ARCHIVE-SCOPE-001",
      "statement": "Every distributed release archive is covered by an out-of-band signed release envelope that binds the exact ZIP byte digest, every entry path, size and digest, and the freeze-profile digest; archive entries outside the signed enumeration are forbidden.",
      "target": "system"
    },
    {
      "id": "INV-AUTH-001",
      "statement": "Только ASET Core создаёт authority-bearing Permit.",
      "target": "core"
    },
    {
      "id": "INV-AUTH-002",
      "statement": "Всё, что не имеет действующего Permit для точного гейта, запрещено.",
      "target": "core"
    },
    {
      "id": "INV-AUTH-003",
      "statement": "CoreResolution имеет только PERMITTED или PROHIBITED; техническая ошибка не является разрешением.",
      "target": "core"
    },
    {
      "id": "INV-BUILD-001",
      "statement": "Release finalization regenerates all generated artifacts before MANIFEST and SHA256SUMS; machine artifacts reproduce byte-for-byte and documents reproduce semantically.",
      "target": "system"
    },
    {
      "id": "INV-BUILD-002",
      "statement": "The externally signed ordered generation source manifest covers every actual generator input and generator or validation executable; an unlisted or changed input invalidates the freeze.",
      "target": "system"
    },
    {
      "id": "INV-CONF-001",
      "statement": "A stored conformance report is never trusted as authority; final validation reruns conformance and verifies its complete unique result-ID set and input digest.",
      "target": "system"
    },
    {
      "id": "INV-CONF-002",
      "statement": "The externally signed assurance contract binds positive and negative indexes, every vector, requirement-oracle mappings, runner and validator bytes, exact counts and the complete expected result-ID set.",
      "target": "system"
    },
    {
      "id": "INV-CONTAINER-001",
      "statement": "Final DOCX packages contain only the signed OPC part and relationship allowlists, and final PDFs contain no embedded files, JavaScript, launch actions, annotations, form actions, incremental trailing revisions or unreferenced payloads.",
      "target": "system"
    },
    {
      "id": "INV-CORE-RES-001",
      "statement": "PERMITTED requires exactly one permit reference and digest; PROHIBITED forbids both and requires reason codes.",
      "target": "core"
    },
    {
      "id": "INV-CORPUS-001",
      "statement": "The positive conformance corpus forms an end-to-end digest-linked signed artifact graph; unresolved or substituted internal references are prohibited.",
      "target": "protocol"
    },
    {
      "id": "INV-CORPUS-002",
      "statement": "Each one-shot Permit in the positive corpus resolves to one exact signed CoreResolution that binds the exact Submission and Permit digest.",
      "target": "protocol"
    },
    {
      "id": "INV-CRYPTO-001",
      "statement": "ASET-JCS-1 canonical bytes, SHA-256 digests and Ed25519 signatures are verified against reproducible positive and negative vectors.",
      "target": "protocol"
    },
    {
      "id": "INV-CRYPTO-002",
      "statement": "Signed normative JSON values prohibit non-integer numbers unless a future version defines and tests a complete cross-language numeric canonicalization profile.",
      "target": "protocol"
    },
    {
      "id": "INV-CRYPTO-003",
      "statement": "ASET-JCS-1 permits only I-JSON safe integers and sorts NFC-normalized object keys by unsigned UTF-8 bytes using published cross-language edge vectors.",
      "target": "protocol"
    },
    {
      "id": "INV-CTX-001",
      "statement": "Существующие Context и SignedContextComponent неизменяемы.",
      "target": "context"
    },
    {
      "id": "INV-CTX-002",
      "statement": "Любое каноническое изменение создаёт новый Context через atomic gate patch set.",
      "target": "context"
    },
    {
      "id": "INV-CTX-003",
      "statement": "Gate является linearization point: patch set, new components/root, scoped HEAD updates, Permit consumption и receipt фиксируются атомарно.",
      "target": "context"
    },
    {
      "id": "INV-CTX-004",
      "statement": "Composite root однозначно зависит от канонически упорядоченных подписанных компонентов.",
      "target": "context"
    },
    {
      "id": "INV-CTX-005",
      "statement": "Изменение dependency component инвалидирует Permit; изменение независимого компонента не обязано его инвалидировать.",
      "target": "context"
    },
    {
      "id": "INV-CTX-006",
      "statement": "Один crossing_id создаёт не более одного target context и receipt; повтор возвращает тот же результат.",
      "target": "context"
    },
    {
      "id": "INV-CUSTOMXML-ALLOWLIST-001",
      "statement": "DOCX custom XML is permitted only through an explicit closed bibliography-part allowlist and exact part hashes; the policy never claims that custom XML is absent when allowlisted parts exist.",
      "target": "system"
    },
    {
      "id": "INV-DOC-001",
      "statement": "Presentation evidence binds exact final DOCX and PDF bytes, renderer versions, per-page rendered equality and accessibility results; final validation reruns the presentation gate.",
      "target": "system"
    },
    {
      "id": "INV-EFFECT-001",
      "statement": "Gate crossing не доказывает dispatch, external effect, verification или acceptance.",
      "target": "monade"
    },
    {
      "id": "INV-EFFECT-002",
      "statement": "Retry разрешён только при NO_EFFECT или доказанной идемпотентности.",
      "target": "monade"
    },
    {
      "id": "INV-ENV-001",
      "statement": "Conformance and generation execute only under the exact externally committed Python dependency closure and native renderer/toolchain fingerprint; environment drift fails before generation or assurance execution.",
      "target": "system"
    },
    {
      "id": "INV-EPI-001",
      "statement": "EXPECTED не является OBSERVED; OBSERVED не является VERIFIED; verified transition не равен Task goal completion.",
      "target": "context"
    },
    {
      "id": "INV-EPI-002",
      "statement": "Worker self-report не является достаточным evidence по умолчанию.",
      "target": "context"
    },
    {
      "id": "INV-EXTRACTED-SCOPE-001",
      "statement": "After extraction, the actual stable regular-file set must equal the MANIFEST set plus only the explicitly enumerated self-referential admission files; unmanifested stable files fail before any final PASS.",
      "target": "system"
    },
    {
      "id": "INV-ID-001",
      "statement": "Every stable ID in the normative machine model is globally unique; conflicting duplicate identities are prohibited.",
      "target": "protocol"
    },
    {
      "id": "INV-ID-002",
      "statement": "Every primary identity in requirements, ADR, verification, model, diagram, conformance, oracle, document and key registries is unique in its declared registry.",
      "target": "protocol"
    },
    {
      "id": "INV-JSON-001",
      "statement": "Every normative JSON input rejects duplicate raw member names before semantic parsing, schema validation, digesting or signature verification.",
      "target": "protocol"
    },
    {
      "id": "INV-MASTER-001",
