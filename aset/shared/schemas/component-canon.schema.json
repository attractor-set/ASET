{
  "$defs": {
    "artifact": {
      "additionalProperties": false,
      "properties": {
        "alias_of": {
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "owner": {
          "type": "string"
        },
        "role": {
          "type": "string"
        },
        "schema": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "name",
        "role",
        "owner",
        "schema"
      ],
      "type": "object"
    },
    "canonAssets": {
      "additionalProperties": false,
      "properties": {
        "conformance_binding": {
          "minLength": 1,
          "type": "string"
        },
        "formal_profile": {
          "minLength": 1,
          "type": "string"
        },
        "invariants": {
          "minLength": 1,
          "type": "string"
        },
        "limitations": {
          "minLength": 1,
          "type": "string"
        },
        "protocol_profile": {
          "minLength": 1,
          "type": "string"
        },
        "requirements": {
          "minLength": 1,
          "type": "string"
        },
        "threat_model": {
          "minLength": 1,
          "type": "string"
        },
        "traceability": {
          "minLength": 1,
          "type": "string"
        },
        "verification_cases": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "requirements",
        "verification_cases",
        "traceability",
        "invariants",
        "limitations",
        "threat_model",
        "protocol_profile",
        "conformance_binding",
        "formal_profile"
      ],
      "type": "object"
    },
    "contextComponent": {
      "additionalProperties": false,
      "properties": {
        "content": {
          "minLength": 1,
          "type": "string"
        },
        "id": {
          "pattern": "^CTX-[A-Z]+$",
          "type": "string"
        },
        "owner": {
          "pattern": "^(MOD|SUB)-[A-Z-]+$",
          "type": "string"
        },
        "type": {
          "enum": [
            "memory",
            "master",
            "task",
            "execution",
            "acceptance",
            "authority"
          ]
        }
      },
      "required": [
        "id",
        "type",
        "owner",
        "content"
      ],
      "type": "object"
    },
    "gateRole": {
      "additionalProperties": false,
      "properties": {
        "document": {
          "type": "string"
        },
        "external_effect": {
          "type": "boolean"
        },
        "gate_id": {
          "type": "string"
        },
        "patch": {
          "type": "string"
        },
        "permit": {
          "type": "string"
        },
        "role": {
          "enum": [
            "PRODUCER",
            "AUTHORITY_ISSUER",
            "SCHEMA_AUTHORITY",
            "CONTEXT_TARGET"
          ]
        },
        "writes": {
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "gate_id",
        "role",
        "document",
        "permit",
        "patch",
        "external_effect",
        "writes"
      ],
      "type": "object"
    },
    "invariant": {
      "additionalProperties": false,
      "properties": {
        "derived_from": {
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "statement": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "id",
        "statement"
      ],
      "type": "object"
    },
    "limitation": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string"
        },
        "required_evidence": {
          "type": "string"
        },
        "severity": {
          "enum": [
            "HIGH",
            "MEDIUM",
            "LOW"
          ]
        },
        "statement": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "severity",
        "statement",
        "required_evidence"
      ],
      "type": "object"
    },
    "localized": {
      "additionalProperties": false,
      "properties": {
        "en": {
          "minLength": 1,
          "type": "string"
        },
        "pt-BR": {
          "minLength": 1,
          "type": "string"
        },
        "ru": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "ru",
        "en",
        "pt-BR"
      ],
      "type": "object"
    },
    "operation": {
      "additionalProperties": false,
      "properties": {
        "classification": {
          "enum": [
            "LOCAL_NON_GOVERNED_COMPUTATION",
            "NORMATIVE_DECISION",
            "AUTHORIZATION_ISSUANCE",
            "GOVERNED_CONTEXT_MUTATION",
            "EXTERNAL_EFFECT",
            "OBSERVATION_ADMISSION",
            "VERIFICATION_PROCESSING",
            "OUTCOME_RECOGNITION"
          ]
        },
        "description": {
          "$ref": "#/$defs/localized"
        },
        "id": {
          "pattern": "^[A-Z][A-Z0-9-]+$",
          "type": "string"
        },
        "input_artifacts": {
          "items": {
            "type": "string"
          },
          "type": "array",
          "uniqueItems": true
        },
        "name": {
          "type": "string"
        },
        "output_artifacts": {
          "items": {
            "type": "string"
          },
          "type": "array",
          "uniqueItems": true
        },
        "seed_mapping": {
          "additionalProperties": false,
          "properties": {
            "justification": {
              "minLength": 1,
              "type": "string"
            },
            "outcome_recognition_required": {
              "type": "boolean"
            },
            "seed_transition_required": {
              "type": "boolean"
            },
            "sequence": {
              "items": {
                "enum": [
                  "Decision",
                  "Permit",
                  "PermitUseReceipt",
                  "ExecutionIntent",
                  "Observation",
                  "Verification",
                  "Outcome"
                ]
              },
              "type": "array"
            }
          },
          "required": [
            "seed_transition_required",
            "sequence",
            "outcome_recognition_required",
            "justification"
          ],
          "type": "object"
        }
      },
      "required": [
        "id",
        "name",
        "classification",
        "description",
        "input_artifacts",
        "output_artifacts",
        "seed_mapping"
      ],
      "type": "object"
    }
  },
  "$id": "urn:aset:schema:component-canon:0.1-rc1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "artifacts": {
      "items": {
        "$ref": "#/$defs/artifact"
      },
      "type": "array"
    },
    "assurance": {
      "additionalProperties": false,
      "properties": {
        "implementation_conformance": {
          "const": "NOT_EXECUTED_PRE_IMPLEMENTATION"
        },
        "limitations": {
          "items": {
            "$ref": "#/$defs/limitation"
          },
          "minItems": 1,
          "type": "array"
        },
        "production_conformance": {
          "const": "HOLD"
        }
      },
      "required": [
        "implementation_conformance",
        "production_conformance",
        "limitations"
      ],
      "type": "object"
    },
    "boundary_invariants": {
      "items": {
        "$ref": "#/$defs/invariant"
      },
      "type": "array"
    },
    "canon_assets": {
      "$ref": "#/$defs/canonAssets"
    },
    "canonical_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "component_id": {
      "pattern": "^aset\\.[a-z][a-z0-9.-]+$",
      "type": "string"
    },
    "context_components": {
      "items": {
        "$ref": "#/$defs/contextComponent"
      },
      "type": "array",
      "uniqueItems": true
    },
    "document_type": {
      "const": "aset-component-canon"
    },
    "gate_roles": {
      "items": {
        "$ref": "#/$defs/gateRole"
      },
      "type": "array"
    },
    "invariants": {
      "items": {
        "$ref": "#/$defs/invariant"
      },
      "type": "array"
    },
    "module_refs": {
      "items": {
        "type": "string"
      },
      "type": "array",
      "uniqueItems": true
    },
    "must_not": {
      "items": {
        "type": "string"
      },
      "type": "array",
      "uniqueItems": true
    },
    "operations": {
      "items": {
        "$ref": "#/$defs/operation"
      },
      "minItems": 1,
      "type": "array"
    },
    "owns": {
      "items": {
        "type": "string"
      },
      "type": "array",
      "uniqueItems": true
    },
    "purpose": {
      "$ref": "#/$defs/localized"
    },
    "requirement_ids": {
      "items": {
        "type": "string"
      },
      "type": "array",
      "uniqueItems": true
    },
    "schema_version": {
      "const": 1
    },
    "source_baseline": {
      "additionalProperties": false,
      "properties": {
        "archive_sha256": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "type": "string"
        },
        "model_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "type": "string"
        },
        "specification_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "type": "string"
        },
        "version": {
          "const": "1.5-rc11"
        }
      },
      "required": [
        "version",
        "archive_sha256",
        "model_digest",
        "specification_digest"
      ],
      "type": "object"
    },
    "state_machine_refs": {
      "items": {
        "type": "string"
      },
      "type": "array",
      "uniqueItems": true
    },
    "status": {
      "enum": [
        "COMPONENT_CANON_CANDIDATE"
      ]
    },
    "version": {
      "pattern": "^0\\.1-rc[1-9][0-9]*$",
      "type": "string"
    }
  },
  "required": [
    "document_type",
    "schema_version",
    "component_id",
    "version",
    "status",
    "source_baseline",
    "purpose",
    "module_refs",
    "owns",
    "must_not",
    "context_components",
    "artifacts",
    "gate_roles",
    "operations",
    "requirement_ids",
    "invariants",
    "boundary_invariants",
    "state_machine_refs",
    "assurance",
    "canon_assets",
    "canonical_digest"
  ],
  "type": "object"
}
