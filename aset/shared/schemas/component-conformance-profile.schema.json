{
  "$id": "urn:aset:schema:component-conformance-profile:0.1-rc1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "canonical_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "document_type": {
      "const": "aset-component-conformance-profile"
    },
    "negative_index": {
      "type": "string"
    },
    "positive_index": {
      "type": "string"
    },
    "profile_id": {
      "const": "aset.component-conformance"
    },
    "required_case_ids": {
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    },
    "schema_version": {
      "const": 1
    },
    "status": {
      "const": "CONFORMANCE_CANDIDATE"
    },
    "version": {
      "const": "0.1-rc1"
    }
  },
  "required": [
    "document_type",
    "schema_version",
    "profile_id",
    "version",
    "status",
    "positive_index",
    "negative_index",
    "required_case_ids",
    "canonical_digest"
  ],
  "type": "object"
}
