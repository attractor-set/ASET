{
  "$id": "urn:aset:schema:aset-component-verification-cases:0.1-rc1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "canonical_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "cases": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "CaseType": {
            "type": "string"
          },
          "DocumentationConformanceStatus": {
            "type": "string"
          },
          "DocumentationOracleID": {
            "type": "string"
          },
          "Environment": {
            "type": "string"
          },
          "EvidenceLocator": {
            "type": "string"
          },
          "ExecutableArtifact": {
            "type": "string"
          },
          "ExpectedErrorCode": {
            "type": "string"
          },
          "ID": {
            "type": "string"
          },
          "ImplementationConformanceStatus": {
            "type": "string"
          },
          "Inputs": {
            "type": "string"
          },
          "Objective": {
            "type": "string"
          },
          "Oracle": {
            "type": "string"
          },
          "OracleType": {
            "type": "string"
          },
          "Owner": {
            "type": "string"
          },
          "Preconditions": {
            "type": "string"
          },
          "Procedure": {
            "type": "string"
          },
          "RequirementID": {
            "type": "string"
          },
          "Status": {
            "type": "string"
          }
        },
        "required": [
          "ID",
          "RequirementID",
          "Objective",
          "Preconditions",
          "Inputs",
          "Procedure",
          "Oracle",
          "Environment",
          "EvidenceLocator",
          "Status",
          "Owner",
          "CaseType",
          "ExecutableArtifact",
          "ExpectedErrorCode",
          "OracleType",
          "DocumentationOracleID",
          "DocumentationConformanceStatus",
          "ImplementationConformanceStatus"
        ],
        "type": "object"
      },
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    },
    "component_id": {
      "pattern": "^(aset\\.[a-z][a-z0-9.-]+|aset.system)$",
      "type": "string"
    },
    "component_version": {
      "const": "0.1-rc1"
    },
    "document_type": {
      "const": "aset-component-verification-cases"
    },
    "schema_version": {
      "const": 1
    },
    "source_version": {
      "const": "1.5-rc11"
    }
  },
  "required": [
    "document_type",
    "schema_version",
    "component_id",
    "component_version",
    "source_version",
    "cases",
    "canonical_digest"
  ],
  "type": "object"
}
