{
  "$id": "urn:aset:schema:component-conformance-index:0.1-rc1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "canonical_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "cases": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "path": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "path"
        ],
        "type": "object"
      },
      "type": "array",
      "uniqueItems": true
    },
    "document_type": {
      "const": "aset-component-conformance-index"
    },
    "kind": {
      "enum": [
        "POSITIVE",
        "NEGATIVE"
      ]
    },
    "schema_version": {
      "const": 1
    }
  },
  "required": [
    "document_type",
    "schema_version",
    "kind",
    "cases",
    "canonical_digest"
  ],
  "type": "object"
}
