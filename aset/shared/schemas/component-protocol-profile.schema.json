{
  "$defs": {
    "componentGateRole": {
      "additionalProperties": false,
      "properties": {
        "document": {
          "type": "string"
        },
        "external_effect": {
          "type": "boolean"
        },
        "gate_id": {
          "type": "string"
        },
        "patch": {
          "type": "string"
        },
        "permit": {
          "type": "string"
        },
        "role": {
          "enum": [
            "PRODUCER",
            "AUTHORITY_ISSUER",
            "SCHEMA_AUTHORITY",
            "CONTEXT_TARGET"
          ]
        },
        "writes": {
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "gate_id",
        "role",
        "document",
        "permit",
        "patch",
        "external_effect",
        "writes"
      ],
      "type": "object"
    },
    "systemGate": {
      "additionalProperties": false,
      "properties": {
        "authority_component": {
          "const": "aset.core"
        },
        "document": {
          "type": "string"
        },
        "document_schema": {
          "pattern": "^[a-z0-9-]+\\.schema\\.json$",
          "type": "string"
        },
        "external_effect": {
          "type": "boolean"
        },
        "failure_codes": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        },
        "id": {
          "pattern": "^GATE-[A-Z-]+$",
          "type": "string"
        },
        "patch": {
          "type": "string"
        },
        "patch_schema": {
          "pattern": "^[a-z0-9-]+\\.schema\\.json$",
          "type": "string"
        },
        "permit": {
          "type": "string"
        },
        "permit_schema": {
          "pattern": "^[a-z0-9-]+\\.schema\\.json$",
          "type": "string"
        },
        "producer": {
          "type": "string"
        },
        "producer_component": {
          "type": "string"
        },
        "reducer_id": {
          "minLength": 1,
          "type": "string"
        },
        "schema_component": {
          "const": "aset.protocol"
        },
        "writes": {
          "items": {
            "type": "string"
          },
          "type": "array",
          "uniqueItems": true
        }
      },
      "required": [
        "id",
        "producer",
        "producer_component",
        "authority_component",
        "schema_component",
        "document",
        "document_schema",
        "permit",
        "permit_schema",
        "patch",
        "patch_schema",
        "external_effect",
        "writes",
        "failure_codes",
        "reducer_id"
      ],
      "type": "object"
    }
  },
  "$id": "urn:aset:schema:component-protocol-profile:0.1-rc1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "canonical_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "component_id": {
      "pattern": "^(aset\\.[a-z][a-z0-9.-]+|aset.system)$",
      "type": "string"
    },
    "component_version": {
      "const": "0.1-rc1"
    },
    "document_type": {
      "const": "aset-component-protocol-profile"
    },
    "gate_roles": {
      "items": {
        "oneOf": [
          {
            "$ref": "#/$defs/componentGateRole"
          },
          {
            "$ref": "#/$defs/systemGate"
          }
        ]
      },
      "type": "array",
      "uniqueItems": true
    },
    "imports": {
      "items": {
        "type": "string"
      },
      "type": "array",
      "uniqueItems": true
    },
    "interfaces": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "classification": {
            "type": "string"
          },
          "inputs": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "uniqueItems": true
          },
          "operation_id": {
            "type": "string"
          },
          "outputs": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "uniqueItems": true
          }
        },
        "required": [
          "operation_id",
          "classification",
          "inputs",
          "outputs"
        ],
        "type": "object"
      },
      "type": "array",
      "uniqueItems": true
    },
    "schema_version": {
      "const": 1
    },
    "seed_bridge": {
      "additionalProperties": false,
      "properties": {
        "canonical_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "type": "string"
        },
        "profile": {
          "const": "aset/shared/seed-bridge/seed-compatibility-profile.json"
        },
        "version": {
          "const": "0.1-rc12"
        }
      },
      "required": [
        "version",
        "profile",
        "canonical_digest"
      ],
      "type": "object"
    }
  },
  "required": [
    "document_type",
    "schema_version",
    "component_id",
    "component_version",
    "seed_bridge",
    "interfaces",
    "gate_roles",
    "imports",
    "canonical_digest"
  ],
  "type": "object"
}
